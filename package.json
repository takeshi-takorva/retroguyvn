{
  "name": "retroguyvn-web",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/ensure-cloudflare-resources.mjs",
    "build": "astro build && node scripts/patch-generated-wrangler.mjs && wrangler deploy --dry-run --outdir .wrangler-dry",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
