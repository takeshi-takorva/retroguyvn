---
interface Props {
  currentPath?: string;
}
const { currentPath = Astro.url.pathname } = Astro.props;
const contentItems = [
  { href: '/admin', label: 'Homepage', icon: 'HM' },
  { href: '/admin/pages/', label: 'Pages', icon: 'PG' },
  { href: '/admin/products', label: 'Products', icon: 'PR' },
  { href: '/admin/devlog', label: 'Developer Log', icon: 'DL' }
];
const platformItems = [
  { href: '/admin/ota', label: 'OTA Firmware', icon: 'OT' },
  { href: '/admin/system', label: 'System', icon: 'SY' }
];
const activeFor = (href: string) => href === '/admin'
  ? currentPath === '/admin' || currentPath === '/admin/'
  : currentPath.startsWith(href.replace(/\/$/, ''));
---
<aside class="admin-sidebar" id="adminSidebar">
  <a class="admin-brand" href="/admin/pages/" aria-label="RetroGuy CMS">
    <span class="admin-brand-mark">RG</span>
    <span class="admin-brand-copy"><strong>RetroGuy CMS</strong><span>Current site workspace</span></span>
  </a>

  <div class="admin-nav-group">
    <div class="admin-nav-label">Content</div>
    <nav class="admin-nav" aria-label="Admin navigation">
      {contentItems.map(item => (
        <a class:list={['admin-nav-item', activeFor(item.href) && 'active']} href={item.href}>
          <span class="admin-nav-icon">{item.icon}</span>
          <span class="admin-nav-text">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="admin-nav-group">
    <div class="admin-nav-label">Platform</div>
    <nav class="admin-nav" aria-label="Platform navigation">
      {platformItems.map(item => (
        <a class:list={['admin-nav-item', activeFor(item.href) && 'active']} href={item.href}>
          <span class="admin-nav-icon">{item.icon}</span>
          <span class="admin-nav-text">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>
