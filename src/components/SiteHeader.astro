---
import { PUBLIC_NAV, isActivePublicRoute } from '../site/navigation.js';

interface Props {
  variant?: 'default' | 'home';
  pathname?: string;
}

const { variant = 'default', pathname = Astro.url.pathname } = Astro.props;
const home = variant === 'home';
---
{home ? (
  <header class="nav">
    <div class="wrap navin">
      <a href="/" aria-label="Retro Guy home"><img class="logo" src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /></a>
      <button class="home-nav-toggle" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
      <nav class="links" aria-label="Primary navigation">
        {PUBLIC_NAV.map(item => <a href={item.href} aria-current={isActivePublicRoute(pathname, item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </div>
  </header>
) : (
  <header class="site-header">
    <a class="brand" href="/" aria-label="RetroGuy VN home">
      <span class="brand-mark">RG</span>
      <span data-cms-global="brand">RETROGUY<span class="accent">VN</span></span>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    <nav class="site-nav" aria-label="Primary navigation">
      {PUBLIC_NAV.map(item => (
        <a href={item.href} class:list={[isActivePublicRoute(pathname, item.href) && 'active']}>{item.label}</a>
      ))}
    </nav>
  </header>
)}

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line, rgba(255,255,255,.1));
    background: rgba(8,16,28,.88);
    backdrop-filter: blur(14px);
  }

  .navin {
    width: min(var(--max, 1180px), calc(100% - 40px));
    height: 76px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav a {
    text-decoration: none;
  }

  .logo {
    display: block;
    width: 220px;
    max-width: 100%;
    max-height: 44px;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  .links {
    display: flex;
    gap: 22px;
    align-items: center;
    font: 700 16px Rajdhani, sans-serif;
    text-transform: uppercase;
  }

  .links a {
    color: #d7dee8;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: #fff;
  }

  .home-nav-toggle {
    display: none;
    background: transparent;
    color: #fff;
    border: 1px solid var(--line, rgba(255,255,255,.1));
    border-radius: 8px;
    padding: 9px 12px;
    font: 700 14px Rajdhani, sans-serif;
    letter-spacing: .08em;
  }

  @media (max-width: 900px) {
    .home-nav-toggle {
      display: block;
    }

    .links {
      display: none;
    }

    .links.open {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      padding: 18px 24px;
      background: #08101c;
      border-bottom: 1px solid var(--line, rgba(255,255,255,.1));
    }
  }

  @media (max-width: 560px) {
    .navin {
      width: min(calc(100% - 26px), var(--max, 1180px));
      height: 66px;
    }

    .logo {
      width: 176px;
    }
  }
</style>

{home ? (
  <script is:inline>
    const button = document.querySelector('.home-nav-toggle');
    const nav = document.querySelector('.links');
    button?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      button.setAttribute('aria-expanded', String(open));
    });
  </script>
) : (
  <script is:inline>
    const button = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.site-nav');
    button?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      button.setAttribute('aria-expanded', String(open));
    });
  </script>
)}