---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RetroGuy VN',
  description = 'RetroGuy VN — product hardware, news, support and development updates.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-cms-global="seo.description" />
    <meta name="theme-color" content="#06121f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title data-cms-global="seo.title">{title}</title>
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>
    <SiteHeader pathname={Astro.url.pathname} />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
