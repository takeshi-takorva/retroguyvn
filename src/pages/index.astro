  <style>
    :root{--bg:#070b14;--navy:#101827;--panel:#131d2f;--panel2:#18243a;--orange:#f0522d;--orange2:#ff6a36;--cyan:#38e0dc;--yellow:#efff39;--cream:#f4ede1;--muted:#9eabc0;--line:rgba(117,139,172,.28);--max:1240px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--cream);font-family:Sora,system-ui,sans-serif;overflow-x:hidden}a{color:inherit;text-decoration:none}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}
    body:before{content:"";position:fixed;inset:0;z-index:40;pointer-events:none;background-image:radial-gradient(rgba(112,135,170,.17) 1px,transparent 1px);background-size:18px 18px;mask-image:linear-gradient(#000,rgba(0,0,0,.18) 80%,transparent)}
    .nav{position:sticky;top:0;z-index:30;background:rgba(7,11,20,.86);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.navin{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand img{width:210px;max-height:48px;object-fit:contain;object-position:left center;display:block}.navlinks{display:flex;align-items:center;gap:22px;font:700 15px Rajdhani;text-transform:uppercase}.navlinks a{color:#dce4ef;transition:.2s}.navlinks a:hover{color:var(--cyan)}.navcta{padding:9px 14px;border:1px solid rgba(240,82,45,.6);border-radius:9px;background:rgba(240,82,45,.1);color:#fff!important}
    .hero{position:relative;min-height:calc(100vh - 76px);display:grid;align-items:center;padding:56px 0 72px;overflow:hidden}.hero:before{content:"";position:absolute;width:760px;height:760px;border-radius:50%;right:-30px;top:50%;transform:translateY(-50%);background:radial-gradient(circle,rgba(56,224,220,.14),transparent 34%),radial-gradient(circle,transparent 47%,rgba(56,224,220,.35) 47.25%,transparent 48%),radial-gradient(circle,transparent 61%,rgba(240,82,45,.4) 61.2%,transparent 62%),radial-gradient(circle,transparent 74%,rgba(239,255,57,.18) 74.2%,transparent 75%);animation:spin 28s linear infinite}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 52%,rgba(240,82,45,.04) 52% 53%,transparent 53%),radial-gradient(circle at 12% 72%,rgba(240,82,45,.16),transparent 24%);pointer-events:none}.hero-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:52px;align-items:center;position:relative;z-index:2}.eyebrow{display:inline-flex;align-items:center;gap:10px;font:700 11px Space Mono;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan)}.eyebrow:before{content:"";width:8px;height:8px;background:var(--cyan);box-shadow:0 0 14px var(--cyan)}.hero h1{margin:20px 0 8px;font:900 clamp(62px,7.6vw,116px)/.83 Orbitron;letter-spacing:-.055em;text-transform:uppercase}.hero h1 .dr{color:var(--orange);text-shadow:8px 8px 0 rgba(240,82,45,.08)}.hero h1 .portal{display:block;color:#f5f7fb}.tag{font:700 clamp(25px,2.8vw,41px)/1 Rajdhani;text-transform:uppercase;color:var(--orange2);font-style:italic}.lead{max-width:650px;font-size:16px;line-height:1.8;color:#d6deea;margin:22px 0 0}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border-radius:9px;border:1px solid var(--line);font:700 18px Rajdhani;text-transform:uppercase;transition:.2s}.btn.primary{background:var(--orange);border-color:var(--orange);box-shadow:0 14px 36px rgba(240,82,45,.22)}.btn.secondary{background:rgba(255,255,255,.035)}.btn:hover{transform:translateY(-2px)}
    .visual{position:relative;min-height:620px;display:grid;place-items:center}.media{background-image:var(--sprite);background-size:300% 200%;background-repeat:no-repeat}.product-main{width:min(590px,88vw);aspect-ratio:1;position:relative;z-index:2;background-position:0 0;border-radius:34px;filter:drop-shadow(0 34px 42px rgba(0,0,0,.48));transition:transform .18s}.visual-ring{position:absolute;width:85%;aspect-ratio:1;border-radius:50%;border:1px solid rgba(56,224,220,.27);box-shadow:0 0 0 34px rgba(56,224,220,.025),0 0 110px rgba(56,224,220,.11)}.badge{position:absolute;z-index:4;padding:10px 12px;background:rgba(10,16,28,.94);border:1px solid rgba(239,255,57,.35);border-radius:9px;box-shadow:0 10px 28px rgba(0,0,0,.25)}.badge b{display:block;font:800 23px Orbitron;color:var(--yellow);line-height:1}.badge span{font:700 10px Space Mono;color:var(--cyan);letter-spacing:.08em}.b1{left:1%;top:16%}.b2{right:0;bottom:17%}.scan{position:absolute;z-index:5;width:68%;height:2px;background:var(--cyan);box-shadow:0 0 18px var(--cyan);animation:scan 4.8s ease-in-out infinite}
