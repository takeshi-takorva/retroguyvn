<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#1A2637" />
  <meta name="description" content="DR Portal by Retro Guy — Pocket Adventure Device." />
  <title>DR Portal — Retro Guy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Rajdhani:wght@600;700&family=Sora:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{--navy:#1A2637;--orange:#CC4233;--accent:#FF6439;--bg:#090D14;--panel:#111A28;--line:rgba(255,255,255,.10);--muted:#AEB9C7;--max:1240px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:#fff;font-family:Sora,system-ui,sans-serif;overflow-x:hidden;position:relative;isolation:isolate}a{color:inherit;text-decoration:none}img{display:block;max-width:100%;height:auto;filter:none!important;mix-blend-mode:normal!important;opacity:1!important}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}
    body:before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,.075) 1px,transparent 1px);background-size:20px 20px;mask-image:linear-gradient(#000,rgba(0,0,0,.18) 78%,transparent)}
    .nav{position:sticky;top:0;z-index:50;background:rgba(9,13,20,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.navin{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand-logo{width:214px;height:auto}.navlinks{display:flex;gap:22px;align-items:center;font:700 16px Rajdhani,sans-serif;text-transform:uppercase}.navcta{padding:10px 14px;border:1px solid rgba(204,66,51,.65);border-radius:9px;background:rgba(204,66,51,.10)}
    .hero{position:relative;overflow:hidden;padding:72px 0 86px;background:radial-gradient(circle at 78% 48%,rgba(204,66,51,.14),transparent 27%),linear-gradient(145deg,#090D14,#101A2A)}.hero:before{content:"";position:absolute;right:-150px;top:50%;width:760px;height:760px;transform:translateY(-50%);border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 76px,rgba(204,66,51,.16) 77px 79px,transparent 80px 124px)}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:center}.eyebrow{font:700 11px Space Mono,monospace;letter-spacing:.14em;text-transform:uppercase;color:#D5DEE9}.eyebrow:before{content:"";display:inline-block;width:8px;height:8px;margin-right:10px;background:var(--orange)}h1{font:900 clamp(64px,8vw,120px)/.84 Orbitron,sans-serif;text-transform:uppercase;letter-spacing:-.055em;margin:22px 0 8px}.dr{color:var(--orange)}.portal{display:block}.tagline{font:700 clamp(28px,3.2vw,46px)/1 Rajdhani,sans-serif;color:var(--accent);text-transform:uppercase;font-style:italic}.lead{max-width:680px;margin:24px 0 0;color:#D1D9E3;font-size:17px;line-height:1.82}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{padding:13px 18px;border-radius:9px;border:1px solid var(--line);font:700 18px Rajdhani,sans-serif;text-transform:uppercase}.btn.primary{background:var(--orange);border-color:var(--orange);box-shadow:0 15px 36px rgba(204,66,51,.25)}
    .hero-media{position:relative;min-height:590px}.hero-product{position:absolute;object-fit:contain}.hero-product.orange{width:min(560px,90%);right:-20px;top:12px;z-index:2}.hero-product.navy{width:min(360px,60%);left:-24px;bottom:-12px;z-index:3}.label{position:absolute;z-index:5;padding:10px 13px;background:#0B111B;border:1px solid rgba(204,66,51,.45);border-radius:9px}.label b{display:block;font:800 15px Orbitron,sans-serif}.label span{font:700 9px Space Mono,monospace;color:#B8C2CF}.label.navy{left:2px;top:105px}.label.orange{right:2px;bottom:65px}
    .stats{background:var(--navy);border-block:1px solid var(--line)}.statgrid{display:grid;grid-template-columns:repeat(5,1fr)}.stat{padding:23px 18px;border-right:1px solid rgba(255,255,255,.09)}.stat:last-child{border:0}.stat strong{display:block;font:900 24px Orbitron,sans-serif}.stat span{display:block;margin-top:6px;font:700 12px Rajdhani,sans-serif;text-transform:uppercase;color:#BCC6D2}
    .section{padding:100px 0;border-bottom:1px solid rgba(255,255,255,.07)}.alt{background:linear-gradient(180deg,#0D1522,#0A101A)}.section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:end;margin-bottom:42px}.kicker{font:700 10px Space Mono,monospace;color:var(--orange);letter-spacing:.14em;text-transform:uppercase}.section-head h2{margin:10px 0 0;font:900 clamp(40px,5vw,70px)/.96 Orbitron,sans-serif;text-transform:uppercase;letter-spacing:-.035em}.section-head h2 em{font-style:normal;color:var(--orange)}.section-head p{margin:0;color:#B9C3D0;line-height:1.82}
    .lifestyle{display:grid;grid-template-columns:1.08fr .92fr;gap:18px}.life{position:relative;min-height:520px;overflow:hidden;border:1px solid var(--line);border-radius:24px;background:#101827}.life img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .35s ease}.life:hover img{transform:scale(1.02)}.life:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(8,12,18,.94) 94%)}.life-copy{position:absolute;z-index:2;left:28px;right:28px;bottom:26px}.life-copy small{font:700 10px Space Mono,monospace;text-transform:uppercase}.life-copy h3{font:700 36px/1 Rajdhani,sans-serif;text-transform:uppercase;margin:8px 0}.life-copy p{margin:0;color:#C7D0DB;line-height:1.65}
    .feature-shell{padding:34px;border:1px solid rgba(204,66,51,.30);border-radius:26px;background:radial-gradient(circle at 50% 42%,rgba(204,66,51,.15),transparent 28%),#080D15}.feature-title{text-align:center;margin-bottom:30px}.feature-title strong{font:900 clamp(48px,7vw,90px)/.88 Orbitron,sans-serif;text-transform:uppercase}.feature-title span{color:var(--orange)}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.feature{min-height:180px;padding:20px;border:1px solid rgba(204,66,51,.38);background:rgba(4,8,14,.72)}.feature b{display:block;font:800 25px/1 Rajdhani,sans-serif;text-transform:uppercase}.feature p{color:#B6C1CF;font-size:13px;line-height:1.62}
    .colorway{display:grid;grid-template-columns:1.15fr .85fr;gap:34px;align-items:center}.media-card{overflow:hidden;border:1px solid var(--line);border-radius:24px;background:#111824}.media-card img{width:100%;height:100%;object-fit:cover}.group-media{aspect-ratio:1.2}.colorway h3{font:900 clamp(42px,5vw,68px)/.96 Orbitron,sans-serif;text-transform:uppercase;margin:0}.colorway h3 span{color:var(--orange)}.colorway p{color:#BDC8D5;line-height:1.82}.swatches{display:flex;gap:11px;margin:24px 0}.swatch{width:42px;height:42px;border-radius:50%;border:3px solid #2A394F}.swatch.navy{background:#1A2637}.swatch.orange{background:#E95C39}.swatch.purple{background:#4A43C7}
    .hardware-wrap{display:grid;grid-template-columns:.94fr 1.06fr;gap:38px;align-items:center}.hardware-media{aspect-ratio:1.45}.hardware-media img{object-fit:contain;background:#101827}.hardware-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hw{padding:19px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.025)}.hw small{font:700 10px Space Mono,monospace}.hw b{display:block;margin:7px 0;font:700 25px Rajdhani,sans-serif;text-transform:uppercase}.hw p{margin:0;color:#ABB7C6;font-size:13px;line-height:1.58}
    .journey{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.step{padding:24px 18px;border-top:2px solid rgba(204,66,51,.60);background:linear-gradient(180deg,rgba(204,66,51,.055),transparent)}.step b{font:800 28px Rajdhani,sans-serif;text-transform:uppercase}.step p{color:#AEBAC8;font-size:13px;line-height:1.65}
    .cta{padding:110px 0;text-align:center;background:radial-gradient(circle at 50% 36%,rgba(204,66,51,.14),transparent 30%),#0B111B}.cta-logo{width:min(520px,82vw);margin:0 auto 34px}.cta h2{font:900 clamp(50px,7vw,96px)/.92 Orbitron,sans-serif;text-transform:uppercase;margin:0}.cta h2 span{color:var(--orange)}.cta p{max-width:720px;margin:22px auto 30px;color:#BCC7D4;line-height:1.82}.footer{padding:30px 0 42px;border-top:1px solid var(--line)}.footer-in{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer-logo{width:180px}.footer small{color:#8795A8}
    @media(max-width:980px){.navlinks{display:none}.hero-grid,.section-head,.colorway,.hardware-wrap{grid-template-columns:1fr}.hero-media{min-height:520px}.statgrid{grid-template-columns:repeat(2,1fr)}.lifestyle{grid-template-columns:1fr}.feature-grid{grid-template-columns:repeat(2,1fr)}.journey{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:620px){.wrap{width:min(100% - 28px,var(--max))}.hero{padding-top:50px}.hero-media{min-height:430px}.hero-product.orange{width:92%;right:-8%}.hero-product.navy{width:58%;left:-4%}.feature-grid,.hardware-list,.journey{grid-template-columns:1fr}.statgrid{grid-template-columns:1fr}.life{min-height:430px}.footer-in{flex-direction:column;align-items:flex-start}}
  </style>
</head>
<body>
  <nav class="nav"><div class="wrap navin"><a href="/"><img class="brand-logo" src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /></a><div class="navlinks"><a href="#experience">Experience</a><a href="#features">Features</a><a href="#product">Product</a><a href="#hardware">Hardware</a><a class="navcta" href="/news">Devlog</a></div></div></nav>
  <main>
    <section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">Retro Guy · Pocket Adventure Device</div><h1><span class="dr">DR</span><span class="portal">Portal</span></h1><div class="tagline">Open the Portal. Enter the Realm.</div><p class="lead">Một thiết bị đồng hành nhỏ gọn để nuôi, huấn luyện, khám phá, chiến đấu và phát triển người bạn đồng hành số. Mang Digital Realm theo bạn — trong lòng bàn tay, trong túi quần, ở bất cứ đâu.</p><div class="actions"><a class="btn primary" href="#features">Explore Features</a><a class="btn" href="#product">View Product</a></div></div><div class="hero-media"><img class="hero-product orange" src="/images/dr-portal/products/orange-angle.webp" alt="DR Portal Orange Edition" /><img class="hero-product navy" src="/images/dr-portal/products/navy-angle.webp" alt="DR Portal Navy Edition" /><div class="label navy"><b>NAVY</b><span>DR PORTAL EDITION</span></div><div class="label orange"><b>ORANGE</b><span>DR PORTAL EDITION</span></div></div></div></section>
    <section class="stats"><div class="wrap statgrid"><div class="stat"><strong>300+</strong><span>Living Digital Monsters</span></div><div class="stat"><strong>500+</strong><span>Branching Evolutions</span></div><div class="stat"><strong>6</strong><span>Regions</span></div><div class="stat"><strong>3v3</strong><span>Team Battle</span></div><div class="stat"><strong>10</strong><span>Save Slots</span></div></div></section>
    <section class="section" id="experience"><div class="wrap"><div class="section-head"><div><div class="kicker">Everyday Companion</div><h2>Designed to go <em>with you.</em></h2></div><p>DR Portal được thiết kế như một thiết bị game đồng hành thay vì một máy chơi game cồng kềnh: thân máy nhỏ, các phím vật lý dễ thao tác và trải nghiệm có thể tiếp tục trong những khoảng thời gian ngắn xuyên suốt ngày.</p></div><div class="lifestyle"><article class="life"><img src="/images/dr-portal/products/lifestyle-hand.webp" alt="DR Portal held in one hand" /><div class="life-copy"><small>One-hand comfort</small><h3>Made for your hand.</h3><p>Form công thái học cho thao tác nhanh bằng một tay, phù hợp với gameplay ngắn và thường xuyên.</p></div></article><article class="life"><img src="/images/dr-portal/products/lifestyle-pocket.webp" alt="DR Portal carried in a pocket" /><div class="life-copy"><small>Pocket size</small><h3>Ready anywhere.</h3><p>Nhỏ gọn để mang đi bất cứ đâu — một người bạn đồng hành cho mọi khoảnh khắc.</p></div></article></div></div></section>
    <section class="section alt" id="features"><div class="wrap feature-shell"><div class="feature-title"><strong>PLAY <span>YOUR WAY</span></strong></div><div class="feature-grid"><div class="feature"><b>Raise & Care</b><p>Nuôi, chăm sóc và xây dựng mối liên kết với Digital Monster.</p></div><div class="feature"><b>Train</b><p>Huấn luyện chỉ số qua nhiều bài tập và mini game.</p></div><div class="feature"><b>Explore</b><p>Khám phá 6 vùng đất, NPC, nhiệm vụ và hoạt động.</p></div><div class="feature"><b>Battle</b><p>Solo, Team và 3v3 với hệ thống chiến đấu có chiều sâu.</p></div><div class="feature"><b>Evolve</b><p>Hơn 500 hướng tiến hóa phân nhánh.</p></div><div class="feature"><b>Dynamic Feedback</b><p>Âm thanh và rung phản hồi trực tiếp theo hành động.</p></div><div class="feature"><b>Save & Grow</b><p>10 save slots cho nhiều hành trình nhân vật.</p></div><div class="feature"><b>Always Expanding</b><p>Nội dung có thể tiếp tục mở rộng qua cập nhật OTA.</p></div></div></div></section>
    <section class="section" id="product"><div class="wrap"><div class="section-head"><div><div class="kicker">Product Family</div><h2>Choose your <em>portal.</em></h2></div><p>Từ Navy Edition trầm, kỹ thuật tới Orange Edition nổi bật, thiết kế giữ chung một DNA: thân máy bo mềm, mặt điều khiển tập trung và màn hình dọc dành cho thế giới pixel art.</p></div><div class="colorway"><div class="media-card group-media"><img src="/images/dr-portal/products/product-family.webp" alt="DR Portal product family" /></div><div><h3>One device.<br /><span>Many identities.</span></h3><div class="swatches"><i class="swatch navy"></i><i class="swatch orange"></i><i class="swatch purple"></i></div><p>Colorway có thể phát triển theo edition, event hoặc collaboration trong tương lai trong khi giữ cấu trúc phần cứng và trải nghiệm cốt lõi thống nhất.</p><a class="btn" href="#hardware">See the Hardware</a></div></div></div></section>
    <section class="section alt" id="hardware"><div class="wrap"><div class="section-head"><div><div class="kicker">Hardware</div><h2>Built for <em>pocket play.</em></h2></div><p>Cấu trúc phần cứng tập trung vào độ gọn, kết nối đơn giản và khả năng mở rộng nội dung. Thiết kế mặt lưng, loa và USB-C được tích hợp để giữ tổng thể liền mạch.</p></div><div class="hardware-wrap"><div class="media-card hardware-media"><img src="/images/dr-portal/products/hardware.webp" alt="DR Portal hardware views" /></div><div class="hardware-list"><div class="hw"><small>Interface</small><b>Physical Controls</b><p>D-pad và các nút chức năng đặt trong vùng ngón tay thao tác tự nhiên.</p></div><div class="hw"><small>Connection</small><b>USB-C</b><p>Cổng kết nối hiện đại cho nguồn và workflow cập nhật phù hợp.</p></div><div class="hw"><small>Feedback</small><b>Speaker + Vibration</b><p>Phản hồi trực tiếp bằng âm thanh và rung trong gameplay.</p></div><div class="hw"><small>Content</small><b>microSD Assets</b><p>Không gian asset linh hoạt cho map, sprite, SFX và nội dung mở rộng.</p></div><div class="hw"><small>Display</small><b>Portrait Pixel UI</b><p>Màn hình dọc phù hợp diện VPet và thế giới pixel art.</p></div><div class="hw"><small>Ergonomics</small><b>Rounded Shell</b><p>Thân máy bo mềm, thân thiện với cầm nắm lâu và mang theo hằng ngày.</p></div></div></div></div></section>
    <section class="section"><div class="wrap"><div class="section-head"><div><div class="kicker">Core Loop</div><h2>Raise. Train. Explore. Battle. Evolve.</h2></div><p>Mỗi hoạt động đều quay trở lại hành trình phát triển người bạn đồng hành số, tạo một vòng lặp ngắn nhưng có chiều sâu để chơi lâu dài.</p></div><div class="journey"><div class="step"><b>Raise</b><p>Chăm sóc và tương tác.</p></div><div class="step"><b>Train</b><p>Phát triển chỉ số.</p></div><div class="step"><b>Explore</b><p>Mở bản đồ và nhiệm vụ.</p></div><div class="step"><b>Battle</b><p>Thử sức mạnh và đội hình.</p></div><div class="step"><b>Evolve</b><p>Mở nhánh phát triển mới.</p></div></div></div></section>
    <section class="cta"><div class="wrap"><img class="cta-logo" src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /><h2>Your world is <span>waiting.</span></h2><p>DR Portal là cánh cửa bỏ túi dẫn vào Digital Realm — một thế giới để nuôi, khám phá, chiến đấu và phát triển theo cách của riêng bạn.</p><div class="actions" style="justify-content:center"><a class="btn primary" href="/news">Follow Development</a><a class="btn" href="/digital-realm">Enter Digital Realm</a></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-in"><img class="footer-logo" src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /><small>© 2026 Retro Guy · DR Portal · Digital Realm</small></div></footer>
