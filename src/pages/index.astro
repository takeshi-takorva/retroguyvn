    .gallery{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}.gallery-card{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#111a2b}.gallery-img{aspect-ratio:1;background-image:var(--sprite);background-size:300% 200%;background-repeat:no-repeat;transition:transform .35s}.gallery-card:hover .gallery-img{transform:scale(1.025)}.g-navy{background-position:0 0}.g-orange{background-position:50% 0}.g-group{background-position:100% 0}.gallery-card div:last-child{padding:18px 20px}.gallery-card b{font:800 24px Rajdhani;text-transform:uppercase}.gallery-card p{font-size:13px;color:#aeb9c8;line-height:1.6;margin:5px 0 0}
    .hardware-wrap{display:grid;grid-template-columns:.95fr 1.05fr;gap:34px;align-items:center}.hardware-media{aspect-ratio:1.28;border:1px solid var(--line);border-radius:24px;background-position:100% 100%;background-color:#101827}.hardware-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hw{padding:20px;border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:14px}.hw small{font:700 10px Space Mono;color:var(--cyan);text-transform:uppercase}.hw b{display:block;margin:7px 0;font:700 26px Rajdhani;text-transform:uppercase}.hw p{margin:0;color:#aebaca;font-size:13px;line-height:1.55}
    .journey{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;counter-reset:step}.step{position:relative;padding:24px 18px 22px;border-top:2px solid rgba(240,82,45,.45);background:linear-gradient(180deg,rgba(240,82,45,.055),transparent)}.step:before{counter-increment:step;content:"0" counter(step);display:block;font:800 13px Space Mono;color:var(--yellow);margin-bottom:24px}.step b{font:800 28px Rajdhani;text-transform:uppercase}.step p{font-size:13px;line-height:1.65;color:#aeb9c8}.step:not(:last-child):after{content:"";position:absolute;right:-8px;top:-6px;width:12px;height:12px;background:var(--orange);transform:rotate(45deg)}
    .cta{padding:120px 0;text-align:center;background:radial-gradient(circle at 50% 35%,rgba(56,224,220,.11),transparent 28%),radial-gradient(circle at 70% 60%,rgba(240,82,45,.12),transparent 27%)}.cta-logo{width:min(420px,72vw);margin:0 auto 34px;display:block}.cta h2{font:900 clamp(52px,7vw,102px)/.92 Orbitron;text-transform:uppercase;margin:0}.cta h2 span{color:var(--orange)}.cta p{max-width:740px;margin:22px auto 30px;line-height:1.8;color:#bec9d7}.footer{border-top:1px solid var(--line);padding:32px 0 44px}.footer-in{display:flex;justify-content:space-between;gap:24px;align-items:center}.footer img{width:180px}.footer small{color:#8796aa;max-width:690px;text-align:right;line-height:1.6}
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s}.reveal.on{opacity:1;transform:none}@keyframes spin{to{transform:translateY(-50%) rotate(360deg)}}@keyframes scan{0%,100%{top:24%}50%{top:75%}}
    @media(max-width:980px){.hero-grid,.section-head,.hardware-wrap{grid-template-columns:1fr}.hero{padding-top:46px}.hero:before{right:-320px}.visual{min-height:520px}.statgrid{grid-template-columns:repeat(3,1fr)}.stat{border-bottom:1px solid var(--line)}.lifestyle{grid-template-columns:1fr}.feature-grid{grid-template-columns:1fr 1fr}.gallery{grid-template-columns:1fr 1fr}.journey{grid-template-columns:1fr 1fr}.step:after{display:none}.brand img{width:175px}}
    @media(max-width:650px){.wrap{width:min(var(--max),calc(100% - 30px))}.navlinks a:not(.navcta){display:none}.navin{height:68px}.brand img{width:154px}.hero{min-height:auto;padding:56px 0}.hero h1{font-size:56px}.hero-grid{gap:18px}.visual{min-height:430px}.product-main{width:390px;max-width:100%}.b1,.b2{display:none}.statgrid{grid-template-columns:1fr 1fr}.section{padding:78px 0}.section-head{gap:20px}.feature-grid,.hardware-list,.gallery,.journey{grid-template-columns:1fr}.life{min-height:470px}.footer-in{flex-direction:column;align-items:flex-start}.footer small{text-align:left}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
  </style>
