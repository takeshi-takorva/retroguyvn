---
const stats = [
  ['300+', 'Living Digital Monsters'],
  ['500+', 'Branching Evolutions'],
  ['6', 'Regions to Explore'],
  ['3v3', 'Team Battle'],
  ['10', 'Save Slots'],
];
const features = [
  ['RAISE', 'Chăm sóc và xây dựng mối liên kết với người bạn đồng hành số.'],
  ['TRAIN', 'Huấn luyện chỉ số qua các hoạt động và mini game.'],
  ['EXPLORE', 'Khám phá vùng đất, NPC, nhiệm vụ và các địa điểm bí mật.'],
  ['BATTLE', 'Chiến đấu solo hoặc theo đội với hệ thống phát triển lâu dài.'],
];
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0b1422" />
  <meta name="description" content="DR Portal by Retro Guy — thiết bị đồng hành bỏ túi để nuôi, huấn luyện, khám phá và chiến đấu trong Digital Realm." />
  <title>DR Portal — Retro Guy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Rajdhani:wght@600;700&family=Sora:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#09111e;--panel:#101b2c;--panel2:#142239;--text:#f5f7fb;--muted:#aeb9c8;--line:rgba(255,255,255,.10);--orange:#d64535;--orange2:#ff6439;--max:1180px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Sora,system-ui,sans-serif;overflow-x:hidden;position:relative;isolation:isolate}a{color:inherit;text-decoration:none}img{display:block;max-width:100%;height:auto}.site-bg{position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 82% 16%,rgba(214,69,53,.11),transparent 30%),linear-gradient(180deg,#08101c,#0b1525)}.site-bg:after{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.075) 1px,transparent 1px);background-size:20px 20px;opacity:.28;mask-image:linear-gradient(#000,rgba(0,0,0,.25) 72%,transparent)}.wrap{width:min(var(--max),calc(100% - 40px));margin:auto}.nav{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line);background:rgba(8,16,28,.88);backdrop-filter:blur(14px)}.navin{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{width:220px;max-height:44px;object-fit:contain;object-position:left center}.links{display:flex;gap:22px;align-items:center;font:700 16px Rajdhani,sans-serif;text-transform:uppercase}.links a{color:#d7dee8}.links a:hover{color:#fff}.hero{padding:72px 0 82px;min-height:calc(100vh - 76px);display:grid;align-items:center}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:68px}.eyebrow{font:700 11px Rajdhani,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#dce3eb}.eyebrow:before{content:"";display:inline-block;width:8px;height:8px;background:var(--orange);margin-right:10px}.hero h1{font:900 clamp(64px,8vw,112px)/.84 Orbitron,sans-serif;letter-spacing:-.055em;text-transform:uppercase;margin:22px 0 10px}.hero h1 span{display:block}.hero h1 .dr{color:var(--orange)}.tagline{font:700 clamp(28px,3vw,42px)/1 Rajdhani,sans-serif;color:var(--orange2);font-style:italic;text-transform:uppercase;margin:0}.lead{color:#c8d1dc;font-size:17px;line-height:1.8;max-width:620px;margin:24px 0 0}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 19px;border-radius:9px;border:1px solid var(--line);font:700 18px Rajdhani,sans-serif;text-transform:uppercase}.btn.primary{background:var(--orange);border-color:var(--orange);box-shadow:0 14px 36px rgba(214,69,53,.2)}.hero-media{position:relative;border:1px solid var(--line);border-radius:28px;overflow:hidden;background:#0e1828;box-shadow:0 30px 80px rgba(0,0,0,.32)}.hero-media img{width:100%;aspect-ratio:1/1;object-fit:cover}.hero-badge{position:absolute;left:18px;bottom:18px;padding:10px 13px;border:1px solid rgba(255,100,57,.55);background:rgba(8,14,24,.88);border-radius:9px;font:700 13px Orbitron,sans-serif}.stats{border-block:1px solid var(--line);background:#18263a}.statgrid{display:grid;grid-template-columns:repeat(5,1fr)}.stat{padding:22px;border-right:1px solid rgba(255,255,255,.08)}.stat:last-child{border:0}.stat strong{font:800 25px Orbitron,sans-serif}.stat span{display:block;margin-top:6px;color:#b4bfcd;font:700 12px Rajdhani,sans-serif;text-transform:uppercase}.section{padding:96px 0;border-bottom:1px solid rgba(255,255,255,.07)}.head{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px;align-items:end;margin-bottom:38px}.kicker{font:700 11px Rajdhani,sans-serif;letter-spacing:.15em;color:var(--orange);text-transform:uppercase}.head h2{font:900 clamp(40px,5vw,66px)/.95 Orbitron,sans-serif;text-transform:uppercase;letter-spacing:-.035em;margin:10px 0 0}.head h2 em{font-style:normal;color:var(--orange)}.head p{margin:0;color:#b8c2cf;line-height:1.8}.lifestyle{display:grid;grid-template-columns:1.08fr .92fr;gap:26px;align-items:center}.photo{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:#0e1828;box-shadow:0 24px 60px rgba(0,0,0,.24)}.photo img{width:100%;max-height:650px;object-fit:cover}.copy h3{font:900 clamp(38px,5vw,64px)/.95 Orbitron,sans-serif;text-transform:uppercase;margin:0}.copy h3 span{color:var(--orange)}.copy p{color:#bcc6d3;line-height:1.8;font-size:16px}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.feature{padding:24px;min-height:210px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.015))}.feature i{display:grid;place-items:center;width:44px;height:44px;border:1px solid rgba(214,69,53,.6);border-radius:10px;color:var(--orange2);font:800 13px Orbitron,sans-serif;font-style:normal}.feature h3{font:800 24px Rajdhani,sans-serif;margin:20px 0 8px}.feature p{color:#aeb9c8;line-height:1.65;font-size:14px;margin:0}.family{display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center}.family img{width:100%;border-radius:26px;border:1px solid var(--line);background:#0e1828}.family h3{font:900 clamp(42px,5vw,68px)/.95 Orbitron,sans-serif;text-transform:uppercase;margin:0}.family h3 span{color:var(--orange)}.family p{color:#b8c2cf;line-height:1.8}.swatches{display:flex;gap:12px;margin:24px 0}.swatch{width:42px;height:42px;border-radius:50%;border:3px solid #33445b}.swatch.navy{background:#1a2637}.swatch.orange{background:#eb5b39}.swatch.purple{background:#5148cc}.hardware{display:grid;grid-template-columns:.82fr 1.18fr;gap:46px;align-items:start}.hardware h3{font:900 clamp(42px,5vw,68px)/.95 Orbitron,sans-serif;text-transform:uppercase;margin:0}.hardware h3 span{color:var(--orange)}.hardware>div>p{color:#b8c2cf;line-height:1.8}.hardware-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.hw{padding:20px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.025)}.hw small{font:700 10px Rajdhani,sans-serif;text-transform:uppercase;color:#9ba8b8}.hw b{display:block;font:700 24px Rajdhani,sans-serif;text-transform:uppercase;margin:7px 0}.hw p{margin:0;color:#aeb9c8;font-size:13px;line-height:1.6}.journey{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.step{padding:23px 18px;border-top:2px solid rgba(214,69,53,.7);background:linear-gradient(180deg,rgba(214,69,53,.06),transparent)}.step b{font:800 26px Rajdhani,sans-serif}.step p{color:#aeb9c8;font-size:13px;line-height:1.65}.cta{text-align:center;padding:110px 0}.cta img{width:min(480px,82vw);margin:0 auto 30px}.cta h2{font:900 clamp(48px,7vw,90px)/.92 Orbitron,sans-serif;text-transform:uppercase;margin:0}.cta h2 span{color:var(--orange)}.cta p{max-width:700px;margin:20px auto 28px;color:#b8c2cf;line-height:1.8}.footer{border-top:1px solid var(--line);padding:28px 0 42px;color:#8795a8;font-size:13px}.footerin{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer img{width:160px}.reveal{animation:up .65s ease both}@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@media(max-width:900px){.links{display:none}.hero{min-height:auto}.hero-grid,.head,.lifestyle,.family,.hardware{grid-template-columns:1fr}.hero-grid{gap:36px}.feature-grid{grid-template-columns:repeat(2,1fr)}.statgrid{grid-template-columns:repeat(2,1fr)}.stat:nth-child(even){border-right:0}.journey{grid-template-columns:1fr 1fr}.head{gap:18px}.section{padding:76px 0}}@media(max-width:560px){.wrap{width:min(100% - 26px,var(--max))}.navin{height:66px}.logo{width:176px}.hero{padding:48px 0 58px}.hero h1{font-size:56px}.feature-grid,.journey,.hardware-grid{grid-template-columns:1fr}.statgrid{grid-template-columns:1fr}.stat{border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}.actions .btn{width:100%}.section{padding:62px 0}}
  </style>
</head>
<body>
  <div class="site-bg" aria-hidden="true"></div>
  <header class="nav"><div class="wrap navin"><a href="/"><img class="logo" src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /></a><nav class="links"><a href="#experience">Experience</a><a href="#features">Features</a><a href="#hardware">Hardware</a><a href="/digital-realm">Digital Realm</a><a href="/news">Devlog</a></nav></div></header>
  <main>
    <section class="hero"><div class="wrap hero-grid"><div class="reveal"><div class="eyebrow">Retro Guy · Pocket Adventure Device</div><h1><span class="dr">DR</span><span>Portal</span></h1><p class="tagline">Open the Portal. Enter the Realm.</p><p class="lead">Một thiết bị đồng hành nhỏ gọn để nuôi, huấn luyện, khám phá, chiến đấu và phát triển người bạn đồng hành số. Mang Digital Realm theo bạn — trong lòng bàn tay, trong túi quần, ở bất cứ đâu.</p><div class="actions"><a class="btn primary" href="#features">Explore Features</a><a class="btn" href="#experience">View Product</a></div></div><div class="hero-media reveal"><img src="/images/dr-portal/products/product-family.webp" alt="DR Portal product family" fetchpriority="high" /><div class="hero-badge">DR PORTAL · PRODUCT FAMILY</div></div></div></section>
    <section class="stats"><div class="wrap statgrid">{stats.map(([n,l]) => <div class="stat"><strong>{n}</strong><span>{l}</span></div>)}</div></section>
    <section class="section" id="experience"><div class="wrap"><div class="head"><div><div class="kicker">Everyday Companion</div><h2>Designed to go <em>with you.</em></h2></div><p>DR Portal được thiết kế như một thiết bị đồng hành thay vì một máy chơi game cồng kềnh: thân máy nhỏ, các phím vật lý dễ thao tác và trải nghiệm có thể tiếp tục trong những khoảng thời gian ngắn xuyên suốt ngày.</p></div><div class="lifestyle"><div class="photo"><img src="/images/dr-portal/products/lifestyle-hand.webp" alt="DR Portal held in one hand" loading="lazy" /></div><div class="copy"><h3>Made for <span>your hand.</span></h3><p>Form công thái học cho thao tác nhanh bằng một tay, phù hợp với gameplay ngắn và thường xuyên. Thiết bị đủ nhỏ để mang theo nhưng vẫn giữ cụm điều khiển vật lý rõ ràng.</p><p>Không cần ứng dụng trung gian để tận hưởng trải nghiệm cốt lõi: mở máy, tiếp tục hành trình và quay lại Digital Realm.</p></div></div></div></section>
    <section class="section" id="features"><div class="wrap"><div class="head"><div><div class="kicker">Core Experience</div><h2>One device. <em>A living world.</em></h2></div><p>Gameplay tập trung vào một vòng lặp dễ hiểu nhưng có chiều sâu: chăm sóc, phát triển, khám phá và chiến đấu. Mỗi hệ thống đều hướng đến việc làm cho nhân vật đồng hành có giá trị lâu dài.</p></div><div class="feature-grid">{features.map(([name,desc],i) => <article class="feature"><i>0{i+1}</i><h3>{name}</h3><p>{desc}</p></article>)}</div></div></section>
    <section class="section"><div class="wrap family"><img src="/images/dr-portal/products/product-family.webp" alt="DR Portal colorways" loading="lazy" /><div><div class="kicker">Product Family</div><h3>One device. <span>Many identities.</span></h3><div class="swatches"><span class="swatch navy"></span><span class="swatch orange"></span><span class="swatch purple"></span></div><p>Colorway có thể phát triển theo edition, event hoặc collaboration trong tương lai trong khi vẫn giữ cấu trúc phần cứng và trải nghiệm cốt lõi thống nhất.</p></div></div></section>
    <section class="section" id="hardware"><div class="wrap hardware"><div><div class="kicker">Hardware</div><h3>Built for <span>pocket play.</span></h3><p>Cấu trúc phần cứng tập trung vào độ gọn, điều khiển trực quan, phản hồi vật lý và khả năng mở rộng nội dung.</p></div><div class="hardware-grid"><article class="hw"><small>Interface</small><b>Physical Controls</b><p>D-pad và các nút chức năng đặt trong vùng ngón tay thao tác tự nhiên.</p></article><article class="hw"><small>Connection</small><b>USB-C</b><p>Cổng kết nối hiện đại cho nguồn và workflow cập nhật.</p></article><article class="hw"><small>Feedback</small><b>Speaker + Vibration</b><p>Phản hồi trực tiếp bằng âm thanh và rung trong gameplay.</p></article><article class="hw"><small>Content</small><b>microSD Assets</b><p>Không gian asset linh hoạt cho map, sprite, SFX và nội dung mở rộng.</p></article><article class="hw"><small>Display</small><b>Portrait Pixel UI</b><p>Màn hình dọc phù hợp với VPet và thế giới pixel art.</p></article><article class="hw"><small>Ergonomics</small><b>Rounded Shell</b><p>Thân máy bo mềm, thân thiện với cầm nắm lâu và mang theo hằng ngày.</p></article></div></div></section>
    <section class="section"><div class="wrap"><div class="head"><div><div class="kicker">Gameplay Loop</div><h2>Raise. Train. Explore. Battle. Evolve.</h2></div><p>Mỗi hành động tạo ra tiến trình cho nhân vật, mở thêm lựa chọn và đưa người chơi quay lại thế giới Digital Realm theo một nhịp tự nhiên.</p></div><div class="journey">{['RAISE','TRAIN','EXPLORE','BATTLE','EVOLVE'].map((x,i)=><div class="step"><b>{x}</b><p>{['Chăm sóc và tương tác.','Phát triển chỉ số.','Khám phá thế giới.','Thử thách đội hình.','Mở nhánh tiến hóa.'][i]}</p></div>)}</div></div></section>
    <section class="cta"><div class="wrap"><img src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" loading="lazy" /><h2>Your digital world <span>is waiting.</span></h2><p>DR Portal là điểm chạm để bước vào Digital Realm — một thiết bị nhỏ gọn dành cho hành trình đồng hành số lâu dài.</p><div class="actions" style="justify-content:center"><a class="btn primary" href="/digital-realm">Enter Digital Realm</a><a class="btn" href="/news">Follow Development</a></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footerin"><img src="/images/brand/retroguy-wordmark.webp" alt="Retro Guy" /><span>© 2026 Retro Guy VN · DR Portal / Digital Realm</span></div></footer>
</body>
</html>
