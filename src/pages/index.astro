  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Rajdhani:wght@600;700&family=Sora:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#070b14;--navy:#101827;--panel:#131d2f;--panel2:#18243a;--orange:#f0522d;--orange2:#ff6a36;--cyan:#38e0dc;--yellow:#efff39;--cream:#f4ede1;--muted:#9eabc0;--line:rgba(117,139,172,.28);--max:1240px;--sprite:none}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--cream);font-family:Sora,system-ui,sans-serif;overflow-x:hidden}a{color:inherit;text-decoration:none}button{font:inherit}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}
    body:before{content:"";position:fixed;inset:0;z-index:40;pointer-events:none;background-image:radial-gradient(rgba(112,135,170,.18) 1px,transparent 1px);background-size:18px 18px;mask-image:linear-gradient(#000,rgba(0,0,0,.2) 78%,transparent)}
    .nav{position:sticky;top:0;z-index:30;background:rgba(7,11,20,.86);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.navin{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;font:900 19px Orbitron}.brandmark{width:36px;height:36px;border:1px solid rgba(240,82,45,.55);border-radius:10px;background:linear-gradient(145deg,#1d2940,#0c1220);display:grid;place-items:center;color:var(--orange);font:900 18px Orbitron}.brand small{display:block;color:var(--muted);font:700 9px Space Mono;letter-spacing:.14em}.navlinks{display:flex;align-items:center;gap:22px;font:700 15px Rajdhani;text-transform:uppercase}.navlinks a{color:#dce4ef;transition:.2s}.navlinks a:hover{color:var(--cyan)}.navcta{padding:9px 14px;border:1px solid rgba(240,82,45,.6);border-radius:9px;background:rgba(240,82,45,.1)!important;color:#fff!important}
    .hero{position:relative;min-height:calc(100vh - 72px);display:grid;align-items:center;padding:64px 0 78px;overflow:hidden}.hero:before{content:"";position:absolute;width:720px;height:720px;border-radius:50%;right:-50px;top:50%;transform:translateY(-50%);background:radial-gradient(circle,rgba(56,224,220,.13),transparent 35%),radial-gradient(circle,transparent 47%,rgba(56,224,220,.35) 47.3%,transparent 48.2%),radial-gradient(circle,transparent 61%,rgba(240,82,45,.38) 61.2%,transparent 62%),radial-gradient(circle,transparent 74%,rgba(239,255,57,.2) 74.2%,transparent 75%);animation:spin 28s linear infinite}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 52%,rgba(240,82,45,.035) 52% 53%,transparent 53%),radial-gradient(circle at 12% 72%,rgba(240,82,45,.16),transparent 24%);pointer-events:none}.hero-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:54px;align-items:center;position:relative;z-index:2}.eyebrow{display:inline-flex;align-items:center;gap:10px;font:700 11px Space Mono;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan)}.eyebrow:before{content:"";width:8px;height:8px;background:var(--cyan);box-shadow:0 0 14px var(--cyan)}.hero h1{margin:20px 0 6px;font:900 clamp(64px,8.2vw,124px)/.82 Orbitron;letter-spacing:-.055em;text-transform:uppercase}.hero h1 .dr{color:var(--orange);text-shadow:8px 8px 0 rgba(240,82,45,.08)}.hero h1 .portal{display:block;color:#f5f7fb}.tag{font:700 clamp(26px,3vw,43px)/1 Rajdhani;text-transform:uppercase;color:var(--orange2);font-style:italic}.lead{max-width:700px;font-size:17px;line-height:1.8;color:#d6deea;margin:22px 0 0}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border-radius:9px;border:1px solid var(--line);font:700 18px Rajdhani;text-transform:uppercase;transition:.2s}.btn.primary{background:var(--orange);border-color:var(--orange);box-shadow:0 14px 36px rgba(240,82,45,.22)}.btn.secondary{background:rgba(255,255,255,.035)}.btn:hover{transform:translateY(-2px)}
    .visual{position:relative;min-height:560px;display:grid;place-items:center}.media{background-image:var(--sprite);background-size:300% 200%;background-repeat:no-repeat}.product-main{width:min(480px,82vw);aspect-ratio:1;position:relative;z-index:2;background-position:0 0;border-radius:36px;filter:drop-shadow(0 32px 36px rgba(0,0,0,.42));transition:transform .18s}.visual-ring{position:absolute;width:82%;aspect-ratio:1;border-radius:50%;border:1px solid rgba(56,224,220,.25);box-shadow:0 0 0 34px rgba(56,224,220,.025),0 0 90px rgba(56,224,220,.08)}.badge{position:absolute;z-index:4;padding:10px 12px;background:rgba(10,16,28,.94);border:1px solid rgba(239,255,57,.35);border-radius:9px;box-shadow:0 10px 28px rgba(0,0,0,.25)}.badge b{display:block;font:800 24px Orbitron;color:var(--yellow);line-height:1}.badge span{font:700 10px Space Mono;color:var(--cyan);letter-spacing:.08em}.b1{left:0;top:18%}.b2{right:0;bottom:19%}.scan{position:absolute;z-index:5;width:66%;height:2px;background:var(--cyan);box-shadow:0 0 18px var(--cyan);animation:scan 4.8s ease-in-out infinite}
    .stats{position:relative;z-index:3;border-block:1px solid var(--line);background:rgba(16,24,39,.82)}.statgrid{display:grid;grid-template-columns:repeat(5,1fr)}.stat{padding:22px 20px;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat strong{display:block;font:900 25px Orbitron;color:var(--yellow)}.stat span{display:block;margin-top:5px;font:700 12px Rajdhani;text-transform:uppercase;color:#b9c4d4;letter-spacing:.06em}
    .section{padding:102px 0;border-bottom:1px solid rgba(117,139,172,.13);position:relative}.dark{background:linear-gradient(180deg,rgba(19,29,47,.62),rgba(8,13,23,.18))}.section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:54px;align-items:end;margin-bottom:42px}.section-head h2{margin:10px 0 0;font:900 clamp(40px,5vw,72px)/.96 Orbitron;text-transform:uppercase;letter-spacing:-.035em}.section-head h2 em{font-style:normal;color:var(--orange)}.section-head>p{margin:0;color:#bcc8d8;line-height:1.8;font-size:16px}
    .lifestyle{display:grid;grid-template-columns:1.08fr .92fr;gap:18px}.life{position:relative;overflow:hidden;border-radius:22px;border:1px solid var(--line);background:#111b2b;min-height:520px}.life.secondary{min-height:520px}.life-img{position:absolute;inset:0;background-size:300% 200%;background-image:var(--sprite);transition:transform .5s}.hand{background-position:0 100%}.pocket{background-position:50% 100%}.life:hover .life-img{transform:scale(1.025)}.life:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(5,8,14,.93))}.life-copy{position:absolute;z-index:2;left:28px;right:28px;bottom:26px}.life-copy small{font:700 10px Space Mono;letter-spacing:.13em;color:var(--cyan);text-transform:uppercase}.life-copy h3{margin:8px 0 6px;font:700 34px Rajdhani;text-transform:uppercase}.life-copy p{margin:0;max-width:600px;color:#cbd4df;line-height:1.65}
    .poster-features{position:relative;overflow:hidden;border:1px solid rgba(240,82,45,.28);border-radius:26px;padding:34px;background:radial-gradient(circle at 52% 42%,rgba(240,82,45,.17),transparent 26%),linear-gradient(135deg,#050914,#0d1525)}.poster-features:before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(240,82,45,.42) 1.3px,transparent 1.3px);background-size:15px 15px;mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent);opacity:.42}.feature-title{position:relative;z-index:2;text-align:center;margin-bottom:30px}.feature-title strong{font:900 clamp(50px,7vw,92px)/.9 Orbitron;text-transform:uppercase}.feature-title strong span{color:var(--orange)}.feature-title p{font:700 22px Rajdhani;color:var(--orange2);font-style:italic;margin:10px 0 0}.feature-grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.feature{min-height:190px;padding:20px;border:1px solid rgba(240,82,45,.45);background:rgba(4,8,15,.72);clip-path:polygon(0 0,92% 0,100% 11%,100% 100%,8% 100%,0 89%);transition:.2s}.feature:hover{transform:translateY(-4px);border-color:var(--yellow)}.feature .ico{height:52px;width:52px;border:2px solid var(--orange);display:grid;place-items:center;color:var(--yellow);font:900 15px Orbitron;margin-bottom:18px}.feature b{display:block;font:800 25px/1 Rajdhani;text-transform:uppercase}.feature p{font-size:13px;line-height:1.62;color:#bfc9d7;margin:9px 0 0}
    .colorway{display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:center}.colorway-media{border-radius:24px;aspect-ratio:1.45;background-position:100% 0;border:1px solid var(--line);box-shadow:0 30px 60px rgba(0,0,0,.25)}.colorway-copy h3{font:900 clamp(42px,5vw,68px)/.96 Orbitron;margin:0;text-transform:uppercase}.colorway-copy h3 span{color:var(--orange)}.colorway-copy p{color:#c3cedc;line-height:1.8}.swatches{display:flex;gap:10px;margin:24px 0}.swatch{width:42px;height:42px;border-radius:50%;border:3px solid #25334a;box-shadow:0 0 0 1px rgba(255,255,255,.15)}.swatch.navy{background:#182744}.swatch.orange{background:#f05a32}.swatch.future{background:linear-gradient(135deg,#332c91,#55c9ff)}
    .hardware-wrap{display:grid;grid-template-columns:.92fr 1.08fr;gap:34px;align-items:center}.hardware-media{aspect-ratio:1.2;border:1px solid var(--line);border-radius:24px;background-position:100% 100%;background-color:#101827}.hardware-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hw{padding:20px;border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:14px}.hw small{font:700 10px Space Mono;color:var(--cyan);text-transform:uppercase}.hw b{display:block;margin:7px 0;font:700 26px Rajdhani;text-transform:uppercase}.hw p{margin:0;color:#aebaca;font-size:13px;line-height:1.55}
    .journey{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;counter-reset:step}.step{position:relative;padding:24px 18px 22px;border-top:2px solid rgba(240,82,45,.45);background:linear-gradient(180deg,rgba(240,82,45,.055),transparent)}.step:before{counter-increment:step;content:"0" counter(step);display:block;font:800 13px Space Mono;color:var(--yellow);margin-bottom:24px}.step b{font:800 28px Rajdhani;text-transform:uppercase}.step p{font-size:13px;line-height:1.65;color:#aeb9c8}.step:not(:last-child):after{content:"";position:absolute;right:-8px;top:-6px;width:12px;height:12px;background:var(--orange);transform:rotate(45deg)}
    .cta{padding:120px 0;text-align:center;background:radial-gradient(circle at 50% 35%,rgba(56,224,220,.11),transparent 28%),radial-gradient(circle at 70% 60%,rgba(240,82,45,.12),transparent 27%)}.cta h2{font:900 clamp(52px,7vw,102px)/.92 Orbitron;text-transform:uppercase;margin:0}.cta h2 span{color:var(--orange)}.cta p{max-width:740px;margin:22px auto 30px;line-height:1.8;color:#bec9d7}.footer{border-top:1px solid var(--line);padding:32px 0 44px}.footer-in{display:flex;justify-content:space-between;gap:24px;align-items:center}.footer strong{font:900 18px Orbitron}.footer small{color:#8796aa;max-width:690px;text-align:right;line-height:1.6}
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s}.reveal.on{opacity:1;transform:none}@keyframes spin{to{transform:translateY(-50%) rotate(360deg)}}@keyframes scan{0%,100%{top:25%}50%{top:74%}}
    @media(max-width:980px){.hero-grid,.section-head,.colorway,.hardware-wrap{grid-template-columns:1fr}.hero{padding-top:48px}.hero:before{right:-280px}.visual{min-height:480px}.statgrid{grid-template-columns:repeat(3,1fr)}.stat{border-bottom:1px solid var(--line)}.lifestyle{grid-template-columns:1fr}.feature-grid{grid-template-columns:1fr 1fr}.journey{grid-template-columns:1fr 1fr}.step:not(:last-child):after{display:none}}
    @media(max-width:640px){.wrap{width:min(var(--max),calc(100% - 30px))}.navlinks a:not(.navcta){display:none}.brand small{display:none}.hero h1{font-size:58px}.visual{min-height:390px}.product-main{width:340px}.badge{display:none}.statgrid{grid-template-columns:1fr 1fr}.stat strong{font-size:20px}.section{padding:76px 0}.lifestyle .life{min-height:390px}.feature-grid,.hardware-list,.journey{grid-template-columns:1fr}.poster-features{padding:20px}.feature{min-height:160px}.footer-in{align-items:flex-start;flex-direction:column}.footer small{text-align:left}.cta{padding:88px 0}.colorway-media{aspect-ratio:1.1}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <nav class="nav"><div class="wrap navin"><a class="brand" href="#top"><span class="brandmark">R</span><span>RETRO GUY<small>POCKET ADVENTURE LAB</small></span></a><div class="navlinks"><a href="#experience">Experience</a><a href="#features">Features</a><a href="#hardware">Hardware</a><a href="/news">Devlog</a><a class="navcta" href="#portal">Open Portal</a></div></div></nav>
  <main id="top">
    <section class="hero"><div class="wrap hero-grid"><div class="reveal"><span class="eyebrow">Pocket Adventure Device</span><h1><span class="dr">DR</span><span class="portal">PORTAL</span></h1><div class="tag">Open the Portal — Enter the Realm</div><p class="lead">Một thiết bị cầm tay nhỏ gọn được xây quanh trải nghiệm nuôi dưỡng một người bạn số: chăm sóc, huấn luyện, khám phá Realm, tham gia hoạt động, chiến đấu cùng đồng đội và tạo ra hướng tiến hóa từ chính cách bạn chơi.</p><div class="actions"><a class="btn primary" href="#features">Explore Features</a><a class="btn secondary" href="/digital-realm">Discover Digital Realm</a></div></div><div class="visual reveal" id="tilt"><div class="visual-ring"></div><div class="product-main media"></div><div class="scan"></div><div class="badge b1"><b>300+</b><span>DIGITAL MONSTERS</span></div><div class="badge b2"><b>3V3</b><span>TEAM BATTLE</span></div></div></div></section>
    <section class="stats"><div class="wrap statgrid"><div class="stat"><strong>300+</strong><span>Living Digital Monsters</span></div><div class="stat"><strong>500+</strong><span>Branching Evolutions</span></div><div class="stat"><strong>6</strong><span>Open World Regions</span></div><div class="stat"><strong>3V3</strong><span>Team Combat Foundation</span></div><div class="stat"><strong>10</strong><span>Character Save Slots</span></div></div></section>
    <section class="section" id="experience"><div class="wrap"><div class="section-head reveal"><div><span class="eyebrow">Made to stay with you</span><h2>Small device.<br><em>Long journey.</em></h2></div><p>DR Portal không được thiết kế như một mini-game chơi xong rồi cất đi. Nó là một vật thể nhỏ đủ để mang theo mỗi ngày, trong khi người bạn số bên trong tiếp tục phát triển cùng lịch chơi, cách chăm sóc và các quyết định của bạn.</p></div><div class="lifestyle"><article class="life reveal"><div class="life-img media hand"></div><div class="life-copy"><small>One-hand ergonomics</small><h3>Comfortable in your hand.</h3><p>Form factor (hình dáng sản phẩm) nhỏ, nút điều khiển trực quan và bố trí dành cho thao tác nhanh bằng một tay.</p></div></article><article class="life secondary reveal"><div class="life-img media pocket"></div><div class="life-copy"><small>Pocket companion</small><h3>Take the Realm anywhere.</h3><p>Đủ nhỏ gọn để bỏ túi và trở thành một người bạn đồng hành trong mọi khoảnh khắc.</p></div></article></div></div></section>
    <section class="section dark" id="features"><div class="wrap"><div class="poster-features reveal"><div class="feature-title"><strong><span>DR</span> PORTAL</strong><p>OPEN THE PORTAL — ENTER THE REALM</p></div><div class="feature-grid"><article class="feature"><div class="ico">300+</div><b>Living Monsters</b><p>Nuôi dưỡng hàng trăm Digital Monsters với hành vi, nhu cầu và quá trình phát triển dài hạn.</p></article><article class="feature"><div class="ico">500+</div><b>Branching Evolution</b><p>Nhiều nhánh tiến hóa chịu ảnh hưởng từ training, care, battle và cách bạn đồng hành cùng nhân vật.</p></article><article class="feature"><div class="ico">MAP</div><b>Open World</b><p>Khám phá nhiều vùng Realm với NPC, shop, quest, contract, event và hoạt động riêng.</p></article><article class="feature"><div class="ico">3V3</div><b>Team Battle</b><p>Combat theo đội tối đa 3 đấu 3 với vai trò, command và phối hợp nhiều nhân vật.</p></article><article class="feature"><div class="ico">ACT</div><b>Activities</b><p>Training, challenge, fishing và nhiều mini-game giúp tăng trưởng không chỉ phụ thuộc combat.</p></article><article class="feature"><div class="ico">SFX</div><b>Sound + Vibration</b><p>Phản hồi âm thanh và rung giúp battle, event, cảnh báo và tương tác có trọng lượng hơn.</p></article><article class="feature"><div class="ico">PAD</div><b>Intuitive Controls</b><p>Điều khiển vật lý trực tiếp, phản hồi rõ ràng và tối ưu cho trải nghiệm bỏ túi.</p></article><article class="feature"><div class="ico">SD</div><b>Expandable Content</b><p>microSD tách asset, map và nội dung khỏi bộ nhớ chính để Realm có thể tiếp tục mở rộng.</p></article></div></div></div></section>
    <section class="section"><div class="wrap colorway"><div class="colorway-media media reveal"></div><div class="colorway-copy reveal"><span class="eyebrow">Choose your Portal</span><h3>One Realm.<br><span>Different identity.</span></h3><p>Thiết kế vỏ được phát triển như một nền tảng có thể mang nhiều phối màu khác nhau. Navy/Orange mang tính nhận diện mạnh, trong khi các phiên bản màu tiếp theo có thể được phát triển theo event, region hoặc collection.</p><div class="swatches"><span class="swatch navy"></span><span class="swatch orange"></span><span class="swatch future"></span></div><a class="btn secondary" href="/gallery">View Gallery</a></div></div></section>
    <section class="section dark" id="hardware"><div class="wrap"><div class="section-head reveal"><div><span class="eyebrow">Designed around pocket play</span><h2>Hardware that<br><em>supports the world.</em></h2></div><p>Phần cứng không chỉ là vỏ chứa game. Màn hình, nút bấm, rung, âm thanh, microSD và USB-C được tổ chức quanh một mục tiêu: tạo cảm giác đây là một thiết bị sống cùng người chơi.</p></div><div class="hardware-wrap"><div class="hardware-media media reveal"></div><div class="hardware-list reveal"><article class="hw"><small>Display</small><b>Pixel-first Screen</b><p>Tỷ lệ màn hình nhỏ gọn phù hợp pixel art và giao diện VPet.</p></article><article class="hw"><small>Controls</small><b>Tactile Input</b><p>D-pad và hệ phím riêng cho thao tác nhanh, rõ và ít phụ thuộc menu cảm ứng.</p></article><article class="hw"><small>Storage</small><b>microSD Content</b><p>Asset và content game có thể được mở rộng mà không làm nặng firmware chính.</p></article><article class="hw"><small>Power / Data</small><b>USB-C</b><p>Cổng sạc và giao tiếp hiện đại nằm trong một thân máy nhỏ.</p></article><article class="hw"><small>Feedback</small><b>Sound + Vibration</b><p>Phản hồi nghe và cảm nhận được bằng tay cho event, battle và notification.</p></article><article class="hw"><small>Wireless</small><b>Connected Play</b><p>Nền tảng cho local multiplayer và các dịch vụ online trong các phase tiếp theo.</p></article></div></div></div></section>
    <section class="section"><div class="wrap"><div class="section-head reveal"><div><span class="eyebrow">Core gameplay loop</span><h2>Raise. Train.<br><em>Explore. Evolve.</em></h2></div><p>Những hệ thống không đứng riêng lẻ. Care ảnh hưởng growth, training chuẩn bị cho exploration, exploration mở activity và battle, còn toàn bộ hành vi đó cùng định hình evolution.</p></div><div class="journey"><article class="step reveal"><b>Raise</b><p>Chăm sóc, tương tác và xây dựng trạng thái dài hạn cho người bạn số.</p></article><article class="step reveal"><b>Train</b><p>Phát triển ATK, DEF, stamina và các năng lực thông qua activity.</p></article><article class="step reveal"><b>Explore</b><p>Đi qua nhiều region, gặp NPC, tìm tài nguyên và mở tuyến nhiệm vụ.</p></article><article class="step reveal"><b>Battle</b><p>Solo hoặc team combat với command, status và chiến thuật theo lượt.</p></article><article class="step reveal"><b>Evolve</b><p>Hướng tiến hóa phản ánh cách bạn đã chăm sóc và chơi cùng nhân vật.</p></article></div></div></section>
    <section class="cta" id="portal"><div class="wrap reveal"><span class="eyebrow">A Digital World In Your Pocket</span><h2><span>Open</span> the Portal.<br>Your World Is Waiting.</h2><p>Mang theo một người bạn số. Khám phá một thế giới. Tạo ra một hành trình khác biệt trên một thiết bị nhỏ đủ để đi cùng bạn mỗi ngày.</p><div class="actions" style="justify-content:center"><a class="btn primary" href="/news">Follow Development</a><a class="btn secondary" href="/download">Downloads</a></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-in"><strong>RETRO GUY · DR PORTAL</strong><small>Product experience website V1.1. Account, OTA, cloud save và online PvP sẽ được bổ sung như các service (dịch vụ) độc lập trong các phase tiếp theo.</small></div></footer>
  <script>
    fetch('/images/dr-portal/site-sprite.b64').then(r=>r.text()).then(b=>document.documentElement.style.setProperty('--sprite',`url("data:image/webp;base64,${b.trim()}")`));
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on')}),{threshold:.1});document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    const tilt=document.getElementById('tilt');if(tilt){tilt.addEventListener('pointermove',e=>{const r=tilt.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;tilt.querySelector('.product-main').style.transform=`perspective(900px) rotateY(${x*7}deg) rotateX(${-y*5}deg) translateY(-4px)`});tilt.addEventListener('pointerleave',()=>tilt.querySelector('.product-main').style.transform='')}
  </script>
</body>
</html>
