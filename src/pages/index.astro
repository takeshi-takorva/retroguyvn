  <script>
    const loadAssets=async()=>{
      try{
        const [spriteRaw,logoRaw]=await Promise.all([
          fetch('/images/dr-portal/site-sprite.b64').then(r=>r.text()),
          fetch('/images/brand/retroguy-wordmark.b64').then(r=>r.text())
        ]);
        document.body.style.setProperty('--sprite',`url("data:image/webp;base64,${spriteRaw.trim()}")`);
        const logoSrc=`data:image/webp;base64,${logoRaw.trim()}`;
        document.querySelectorAll('.rg-logo').forEach(img=>img.setAttribute('src',logoSrc));
      }catch(err){console.error('Asset loading failed',err)}
    };
    loadAssets();
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('on')}),{threshold:.1});
    document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
    const tilt=document.getElementById('tilt');
    if(tilt){tilt.addEventListener('pointermove',e=>{const r=tilt.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5;const y=(e.clientY-r.top)/r.height-.5;const p=tilt.querySelector('.product-main');if(p)p.style.transform=`perspective(1000px) rotateY(${x*7}deg) rotateX(${-y*6}deg) translateY(-4px)`});tilt.addEventListener('pointerleave',()=>{const p=tilt.querySelector('.product-main');if(p)p.style.transform=''})}
  </script>
</body>
</html>