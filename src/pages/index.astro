  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@700&family=Sora:wght@400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{--navy:#16213A;--ink:#0E1627;--red:#D8452E;--cyan:#3FE1D4;--amber:#F2A93B;--cream:#F4EDE1;--slate:#5C6B84;--line:rgba(92,107,132,.35);--max:1200px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--navy);color:var(--cream);font-family:Sora,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;z-index:40;pointer-events:none;background:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(#000,transparent 82%)}a{color:inherit;text-decoration:none}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}
    .nav{position:sticky;top:0;z-index:30;background:rgba(22,33,58,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav-in{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font:900 22px Orbitron,sans-serif;letter-spacing:.06em}.brand span{color:var(--red)}.links{display:flex;gap:22px;align-items:center;font:700 17px Rajdhani,sans-serif;text-transform:uppercase}.links a{transition:.2s}.links a:hover{color:var(--cyan)}.pill{padding:9px 14px;border:1px solid rgba(216,69,46,.65);border-radius:999px;background:rgba(216,69,46,.08)}
    .hero{position:relative;min-height:calc(100vh - 72px);display:flex;align-items:center;padding:54px 0 78px;overflow:hidden}.hero:before{content:"";position:absolute;width:620px;height:620px;border-radius:50%;right:6%;top:50%;transform:translateY(-50%);background:radial-gradient(circle,transparent 42%,rgba(63,225,212,.56) 42.3%,rgba(63,225,212,.08) 46%,transparent 47.5%),radial-gradient(circle,transparent 57%,rgba(242,169,59,.65) 57.3%,rgba(242,169,59,.07) 61%,transparent 62.3%),radial-gradient(circle,transparent 70%,rgba(216,69,46,.62) 70.3%,rgba(216,69,46,.05) 74%,transparent 75%);filter:drop-shadow(0 0 32px rgba(63,225,212,.18));animation:spin 22s linear infinite}.hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:46px;align-items:center;position:relative;z-index:2}.kicker{display:inline-flex;align-items:center;gap:9px;color:var(--cyan);font:700 11px "Space Mono",monospace;letter-spacing:.15em;text-transform:uppercase}.kicker:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}h1{font:900 clamp(62px,8vw,118px)/.9 Orbitron,sans-serif;letter-spacing:-.045em;margin:22px 0 12px;text-transform:uppercase}h1 span{color:var(--red)}.tagline{font:700 clamp(27px,3.2vw,46px)/1 Rajdhani,sans-serif;text-transform:uppercase;color:var(--amber);margin-bottom:18px}.lead{max-width:670px;font-size:17px;line-height:1.8;color:#eee5d6}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;padding:13px 19px;border-radius:14px;font:700 20px Rajdhani,sans-serif;text-transform:uppercase;border:1px solid var(--line);transition:.2s}.btn.primary{background:var(--red);border-color:var(--red);box-shadow:0 14px 34px rgba(216,69,46,.25)}.btn.secondary{background:rgba(244,237,225,.04)}.btn:hover{transform:translateY(-2px)}
    .product-stage{position:relative;z-index:3;max-width:520px;min-height:520px;margin:auto;padding:22px;border-radius:30px;background:rgba(14,22,39,.44);border:1px solid rgba(244,237,225,.12);backdrop-filter:blur(8px);display:grid;place-items:center;transition:transform .18s}.portal-glow{position:absolute;inset:10%;border-radius:50%;background:radial-gradient(circle,rgba(63,225,212,.19),rgba(63,225,212,.03) 42%,transparent 68%);filter:blur(12px)}.device{position:relative;width:min(310px,72vw);aspect-ratio:.72;background:linear-gradient(145deg,#e2a52f,#b56c19 58%,#75430d);border-radius:34% 34% 29% 29%/22% 22% 18% 18%;box-shadow:0 32px 42px rgba(0,0,0,.42),inset 0 0 0 5px rgba(255,228,125,.16);transform:rotate(-2deg)}.device:before{content:"";position:absolute;left:13%;right:13%;top:9%;height:43%;border-radius:22%;background:#080d17;border:5px solid #263246;box-shadow:inset 0 0 0 2px #05080e}.screen{position:absolute;z-index:2;left:22%;right:22%;top:16%;height:29%;border:2px solid var(--cyan);background:repeating-linear-gradient(0deg,rgba(63,225,212,.05) 0 2px,transparent 2px 5px),#09253a;box-shadow:0 0 18px rgba(63,225,212,.24);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:"Space Mono",monospace}.screen strong{font-size:11px;color:#ffe15e}.screen span{font-size:10px;color:#d5f8f4;margin-top:8px}.radar{width:48px;height:48px;margin-top:9px;border:1px solid var(--cyan);border-radius:50%;box-shadow:0 0 0 8px rgba(63,225,212,.12),0 0 0 16px rgba(63,225,212,.06)}.controls{position:absolute;left:15%;right:15%;bottom:10%;height:34%}.dpad{position:absolute;width:130px;height:130px;left:50%;top:3%;transform:translateX(-50%)}.dpad i{position:absolute;background:#d84b31;border:3px solid #6e2419;box-shadow:inset 0 2px 3px rgba(255,255,255,.22)}.dpad .u,.dpad .d{width:49px;height:52px;left:41px;border-radius:15px}.dpad .u{top:0}.dpad .d{bottom:0}.dpad .l,.dpad .r{width:52px;height:49px;top:41px;border-radius:15px}.dpad .l{left:0}.dpad .r{right:0}.dpad .ok{width:48px;height:48px;left:42px;top:42px;border-radius:50%}.side-btn{position:absolute;top:20px;width:54px;height:37px;border-radius:14px;background:#d84b31;border:3px solid #6e2419}.side-btn.left{left:-2px;transform:rotate(24deg)}.side-btn.right{right:-2px;transform:rotate(-24deg)}.bottom-btn{position:absolute;bottom:-8px;width:58px;height:39px;border-radius:13px;background:#d84b31;border:3px solid #6e2419}.bottom-btn.left{left:18px}.bottom-btn.right{right:18px}.scan{position:absolute;z-index:6;left:15%;right:15%;height:2px;top:30%;background:var(--cyan);box-shadow:0 0 16px var(--cyan);opacity:.7;animation:scan 4.5s ease-in-out infinite}.micro{position:absolute;z-index:7;background:rgba(14,22,39,.92);border:1px solid rgba(63,225,212,.28);border-radius:14px;padding:10px 12px;box-shadow:0 0 18px rgba(63,225,212,.1)}.micro b{display:block;color:var(--amber);font:700 20px Rajdhani,sans-serif;line-height:1}.micro span{font:400 10px "Space Mono",monospace;color:var(--cyan)}.m1{left:-18px;top:12%}.m2{right:-16px;bottom:12%}
    .section{padding:96px 0;border-top:1px solid var(--line);position:relative}.section.dark{background:rgba(14,22,39,.30)}.section-head{display:grid;grid-template-columns:.82fr 1.18fr;gap:42px;align-items:end;margin-bottom:40px}.section-head h2{margin:10px 0 0;font:900 clamp(38px,5vw,70px)/.98 Orbitron,sans-serif;text-transform:uppercase}.section-head h2 span{color:var(--red)}.section-head p{margin:0;color:#e7ddce;line-height:1.8}.story{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.quote{font:900 clamp(46px,6vw,82px)/.96 Orbitron,sans-serif;text-transform:uppercase}.quote span{color:var(--red)}.story p{color:#e8ddcd;line-height:1.85;font-size:17px}.story strong{color:var(--amber)}
    .features{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.feature{min-height:250px;padding:22px;border-radius:24px;background:linear-gradient(180deg,rgba(244,237,225,.055),rgba(244,237,225,.02));border:1px solid var(--line);transition:.22s}.feature:hover{transform:translateY(-4px);border-color:rgba(63,225,212,.45)}.icon{height:62px;width:62px;border-radius:20px;display:grid;place-items:center;background:rgba(14,22,39,.8);border:1px solid rgba(63,225,212,.25);box-shadow:0 0 18px rgba(63,225,212,.09);margin-bottom:22px;color:var(--cyan);font:700 24px Orbitron,sans-serif}.feature:nth-child(even) .icon{color:var(--amber);border-color:rgba(242,169,59,.25)}.feature h3{margin:0 0 8px;font:700 27px/1 Rajdhani,sans-serif;text-transform:uppercase}.feature p{margin:0;color:#e8dece;line-height:1.68;font-size:14px}
    .journey{display:grid;grid-template-columns:.74fr 1.26fr;gap:32px;align-items:start}.journey-panel{position:sticky;top:94px;padding:22px;border-radius:24px;background:rgba(244,237,225,.045);border:1px solid var(--line)}.mini-product{position:relative;height:330px;border-radius:18px;overflow:hidden;background:radial-gradient(circle at 50% 45%,rgba(63,225,212,.17),transparent 32%),linear-gradient(145deg,#e8dfce,#bfae94)}.mini-product:before,.mini-product:after{content:"";position:absolute;top:58px;width:150px;height:225px;border-radius:55px 55px 45px 45px}.mini-product:before{left:24%;background:#17243c;transform:rotate(-7deg);box-shadow:0 20px 35px rgba(0,0,0,.28)}.mini-product:after{right:21%;background:#d39a2d;transform:rotate(8deg)}.journey-panel h3{font:700 30px Rajdhani,sans-serif;text-transform:uppercase;color:var(--amber);margin:18px 0 6px}.journey-panel p{margin:0;color:#e9dfcf;line-height:1.7}.steps{display:flex;flex-direction:column;gap:14px}.step{display:grid;grid-template-columns:80px 1fr;gap:18px;align-items:center;padding:20px 22px;border-radius:22px;background:rgba(244,237,225,.045);border:1px solid var(--line)}.num{height:64px;width:64px;border-radius:20px;display:grid;place-items:center;color:var(--amber);font:700 18px Orbitron,sans-serif;background:rgba(242,169,59,.06);border:1px solid rgba(242,169,59,.25)}.step strong{font:700 28px Rajdhani,sans-serif}.step p{margin:7px 0 0;color:#e9dfcf;line-height:1.65}
    .hardware{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.hw{padding:22px;border-radius:22px;border:1px solid var(--line);background:rgba(244,237,225,.04)}.hw small{font:400 11px "Space Mono",monospace;color:var(--cyan);letter-spacing:.12em;text-transform:uppercase}.hw b{display:block;margin:8px 0 7px;font:700 28px Rajdhani,sans-serif;text-transform:uppercase}.hw p{margin:0;color:#e8dece;line-height:1.65;font-size:14px}.cta{padding:110px 0 120px;text-align:center;background:radial-gradient(circle at 50% 38%,rgba(63,225,212,.08),transparent 34%),radial-gradient(circle at 70% 60%,rgba(242,169,59,.07),transparent 24%)}.cta h2{margin:0;font:900 clamp(48px,7vw,102px)/.95 Orbitron,sans-serif;text-transform:uppercase}.cta h2 span{color:var(--red)}.cta p{max-width:720px;margin:23px auto 28px;color:#e7ddce;line-height:1.8}.footer{padding:30px 0 42px;border-top:1px solid var(--line)}.footer-in{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer b{font:900 18px Orbitron,sans-serif}.footer small{max-width:690px;text-align:right;line-height:1.6;color:#cfc5b6}.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s,transform .7s}.reveal.on{opacity:1;transform:none}
    @keyframes spin{to{transform:translateY(-50%) rotate(360deg)}}@keyframes scan{0%,100%{top:29%}50%{top:75%}}
    @media(max-width:1000px){.hero-grid,.section-head,.story,.journey{grid-template-columns:1fr}.features{grid-template-columns:repeat(2,1fr)}.hardware{grid-template-columns:1fr 1fr}.journey-panel{position:relative;top:0}.hero:before{right:-120px}.product-stage{margin-top:20px}}
    @media(max-width:650px){.wrap{width:min(100% - 32px,var(--max))}.links a:not(.pill){display:none}.features,.hardware{grid-template-columns:1fr}.m1,.m2{display:none}.hero:before{width:450px;height:450px;right:-145px}.product-stage{min-height:430px;padding:14px}.device{width:250px}.footer-in{flex-direction:column;align-items:flex-start}.footer small{text-align:left}h1{font-size:58px}.section{padding:72px 0}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero:before,.scan{animation:none}.reveal{opacity:1;transform:none;transition:none}.product-stage{transition:none}}
  </style>
</head>
<body>
  <nav class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="#top" aria-label="DR Portal"><span>DR</span> PORTAL</a>
      <div class="links">
        <a href="#experience">Experience</a><a href="#features">Features</a><a href="#journey">Journey</a><a href="#hardware">Hardware</a><a href="/news">Devlog</a><a class="pill" href="#cta">Open Portal</a>
      </div>
    </div>
  </nav>

  <main id="top">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="kicker">Pocket Adventure Device</div>
          <h1><span>DR</span><br />PORTAL</h1>
          <div class="tagline">OPEN THE PORTAL. YOUR WORLD IS WAITING.</div>
          <p class="lead">Một thiết bị cầm tay nhỏ. Một thế giới số sống ở phía bên kia màn hình. Nuôi Digimon của bạn, huấn luyện, khám phá Realm, chiến đấu cùng đồng đội và định hình con đường tiến hóa từ chính cách bạn chơi.</p>
          <div class="actions"><a class="btn primary" href="#experience">Discover the Experience</a><a class="btn secondary" href="#features">View Features</a></div>
        </div>
        <div class="product-stage reveal" id="tilt" aria-label="DR Portal product concept">
          <div class="portal-glow"></div><div class="scan"></div>
          <div class="device"><div class="screen"><strong>CREAT TEAM</strong><span>Finding...</span><div class="radar"></div></div><div class="controls"><i class="side-btn left"></i><i class="side-btn right"></i><div class="dpad"><i class="u"></i><i class="d"></i><i class="l"></i><i class="r"></i><i class="ok"></i></div><i class="bottom-btn left"></i><i class="bottom-btn right"></i></div></div>
          <div class="micro m1"><b>PORTAL OPEN</b><span>REALM LINK // READY</span></div><div class="micro m2"><b>KEEPER ONLINE</b><span>JOURNEY // ACTIVE</span></div>
        </div>
      </div>
    </section>

    <section class="section dark" id="experience"><div class="wrap story"><div class="quote reveal">THIS ISN'T JUST<br />A GAME DEVICE.<br /><span>IT'S A PORTAL.</span></div><div class="reveal"><p>Mỗi lần màn hình sáng lên, bạn không chỉ mở một game. Bạn quay trở lại với một Digimon đang chờ được chăm sóc, một hành trình đang tiếp diễn và một Digital Realm còn rất nhiều thứ chưa khám phá.</p><p>DR Portal được thiết kế quanh cảm giác <strong>“thế giới tiếp tục sống”</strong>. Cách bạn chăm sóc, chiến đấu và khám phá đều trở thành một phần của lịch sử Digimon của bạn.</p></div></div></section>

    <section class="section" id="features"><div class="wrap"><div class="section-head"><div><div class="kicker">Product Features</div><h2>EVERYTHING<br /><span>BEHIND THE SCREEN</span></h2></div><p>Không trình bày thông số như một danh sách khô cứng. Mỗi tính năng bên dưới được diễn giải từ trải nghiệm mà người chơi thực sự nhận được khi sử dụng DR Portal.</p></div><div class="features">
      <article class="feature reveal"><div class="icon">01</div><h3>Living Digital Companion</h3><p>Nuôi dưỡng một Digimon có nhu cầu, cảm xúc, trạng thái và phản ứng theo cách bạn chăm sóc.</p></article>
      <article class="feature reveal"><div class="icon">02</div><h3>Branching Evolution</h3><p>Không chỉ lên level. Chăm sóc, huấn luyện, chiến đấu và lựa chọn của bạn mở ra những hướng tiến hóa khác nhau.</p></article>
      <article class="feature reveal"><div class="icon">03</div><h3>Realm Exploration</h3><p>Rời Home để khám phá bản đồ, gặp NPC, nhận nhiệm vụ, thu thập tài nguyên, câu cá và tìm bí mật.</p></article>
      <article class="feature reveal"><div class="icon">04</div><h3>Team Battle System</h3><p>Combat theo đội hình, có turn, skill, item, target và những khoảnh khắc chiến đấu mang tính trình diễn.</p></article>
      <article class="feature reveal"><div class="icon">05</div><h3>Local Wireless Play</h3><p>Kết nối trực tiếp các thiết bị để battle hoặc lập đội mà không phụ thuộc máy chủ Internet.</p></article>
      <article class="feature reveal"><div class="icon">06</div><h3>Sound + Vibration</h3><p>Âm thanh và phản hồi rung khiến cảnh báo, combat và các sự kiện có cảm giác vật lý rõ ràng hơn.</p></article>
      <article class="feature reveal"><div class="icon">07</div><h3>Persistent Journey</h3><p>Digimon, chỉ số, nhiệm vụ và tiến trình được lưu lại để mỗi lần mở Portal là tiếp tục một hành trình dài hạn.</p></article>
      <article class="feature reveal"><div class="icon">08</div><h3>Portable Hardware</h3><p>Điều khiển vật lý, màn hình màu, microSD và USB-C tạo nên trải nghiệm handheld độc lập, tập trung.</p></article>
    </div></div></section>

    <section class="section dark" id="journey"><div class="wrap"><div class="section-head"><div><div class="kicker">Core Gameplay Loop</div><h2>RAISE. TRAIN.<br /><span>EXPLORE. EVOLVE.</span></h2></div><p>DR Portal không xoay quanh một trận đấu hay một mini-game duy nhất. Trải nghiệm được nối thành một vòng dài hạn, trong đó chăm sóc, tăng trưởng, khám phá và chiến đấu đều tác động đến Digimon của bạn.</p></div><div class="journey"><aside class="journey-panel reveal"><div class="mini-product" aria-hidden="true"></div><h3>Your journey stays with you.</h3><p>Từ Home đến Realm, từ battle đến evolution, tiến trình được lưu để thiết bị trở thành một “cánh cổng cá nhân” thay vì một trò chơi bắt đầu lại mỗi lần bật máy.</p></aside><div class="steps">
      <div class="step reveal"><div class="num">01</div><div><strong>RAISE</strong><p>Cho ăn, chăm sóc, theo dõi trạng thái và xây dựng mối quan hệ.</p></div></div>
      <div class="step reveal"><div class="num">02</div><div><strong>TRAIN</strong><p>Rèn luyện để thay đổi sức mạnh và định hình hướng phát triển.</p></div></div>
      <div class="step reveal"><div class="num">03</div><div><strong>EXPLORE</strong><p>Bước ra Realm, khám phá môi trường, NPC, tài nguyên và hoạt động.</p></div></div>
      <div class="step reveal"><div class="num">04</div><div><strong>BATTLE</strong><p>Chiến đấu, xây đội hình và đối mặt với những thử thách lớn hơn.</p></div></div>
      <div class="step reveal"><div class="num">05</div><div><strong>EVOLVE</strong><p>Từ những gì đã trải qua, Digimon mở ra một hình thái mới.</p></div></div>
    </div></div></div></section>

    <section class="section" id="hardware"><div class="wrap"><div class="section-head"><div><div class="kicker">Physical Experience</div><h2>BUILT TO FEEL<br /><span>LIKE A REAL DEVICE.</span></h2></div><p>Phần cứng không phải headline chính, nhưng là thứ làm trải nghiệm khác với một app trên điện thoại: nút vật lý, màn hình riêng, âm thanh, rung, microSD và USB-C khiến Portal có cảm giác là một đồ vật bạn thực sự mang theo.</p></div><div class="hardware">
      <div class="hw reveal"><small>Control</small><b>Physical Buttons</b><p>D-pad và nhiều nút chức năng tạo thao tác trực tiếp, rõ ràng và có tính handheld.</p></div>
      <div class="hw reveal"><small>Display</small><b>128 × 160 Color TFT</b><p>Màn hình nhỏ tập trung, phù hợp với pixel art, VPet và trải nghiệm bỏ túi.</p></div>
      <div class="hw reveal"><small>Feedback</small><b>Sound + Vibration</b><p>Phản hồi nghe và cảm nhận được bằng tay giúp battle, event và cảnh báo có trọng lượng hơn.</p></div>
      <div class="hw reveal"><small>Storage</small><b>microSD Content</b><p>Asset, map và nội dung game được tách khỏi bộ nhớ chính để mở rộng trải nghiệm.</p></div>
      <div class="hw reveal"><small>Connection</small><b>Local Wireless</b><p>Cho phép các Portal kết nối trực tiếp để battle hoặc chơi đội trong phạm vi cục bộ.</p></div>
      <div class="hw reveal"><small>Power / Data</small><b>USB-C</b><p>Cổng kết nối hiện đại cho sạc và giao tiếp thiết bị trong một sản phẩm nhỏ gọn.</p></div>
    </div></div></section>

