    .section{padding:104px 0;border-bottom:1px solid rgba(117,139,172,.13);position:relative}.dark{background:linear-gradient(180deg,rgba(19,29,47,.62),rgba(8,13,23,.18))}.section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:54px;align-items:end;margin-bottom:42px}.section-head h2{margin:10px 0 0;font:900 clamp(40px,5vw,72px)/.96 Orbitron;text-transform:uppercase;letter-spacing:-.035em}.section-head h2 em{font-style:normal;color:var(--orange)}.section-head>p{margin:0;color:#bcc8d8;line-height:1.8;font-size:16px}
    .lifestyle{display:grid;grid-template-columns:1.08fr .92fr;gap:18px}.life{position:relative;overflow:hidden;border-radius:22px;border:1px solid var(--line);background:#111b2b;min-height:560px}.life-img{position:absolute;inset:0;background-size:300% 200%;background-image:var(--sprite);transition:transform .5s}.hand{background-position:0 100%}.pocket{background-position:50% 100%}.life:hover .life-img{transform:scale(1.028)}.life:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(5,8,14,.95))}.life-copy{position:absolute;z-index:2;left:28px;right:28px;bottom:26px}.life-copy small{font:700 10px Space Mono;letter-spacing:.13em;color:var(--cyan);text-transform:uppercase}.life-copy h3{margin:8px 0 6px;font:700 35px Rajdhani;text-transform:uppercase}.life-copy p{margin:0;max-width:600px;color:#cbd4df;line-height:1.65}
