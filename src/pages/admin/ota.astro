---
import AdminShell from '../../components/admin/AdminShell.astro';
import '../../styles/ota-admin.css';
---
<AdminShell title="OTA Firmware" subtitle="Digital Realm Game FW + optional SD assets." currentPath="/admin/ota">
  <a slot="topbar-actions" class="admin-button subtle" href="/admin/system">System</a>

  <section class="admin-section-head">
    <div>
      <h2>DR Portal OTA</h2>
      <p>One release = one Game FW version plus an optional VGI assets pack. Boot FW and Service OS are never OTA targets.</p>
    </div>
    <div class="admin-section-actions"><button class="admin-button" id="refreshAll" type="button">Refresh</button></div>
  </section>

  <section class="admin-login" id="loginPanel">
    <h3>Admin access required</h3>
    <p>Cloudflare Access is preferred. Enter the fallback Admin Token only when Access is not active.</p>
    <form class="admin-login-form" id="loginForm">
      <input class="admin-input" id="tokenInput" type="password" placeholder="Admin Token" autocomplete="current-password" required />
      <button class="admin-button primary">Connect</button>
    </form>
  </section>

  <div id="workspace" class="admin-hidden">
    <div class="ota-summary">
      <div class="ota-metric"><span>Published</span><strong id="metricPublished">0</strong></div>
      <div class="ota-metric"><span>Draft</span><strong id="metricDraft">0</strong></div>
      <div class="ota-metric"><span>Latest</span><strong id="metricLatest">—</strong></div>
      <div class="ota-metric"><span>Assets packs</span><strong id="metricAssets">0</strong></div>
    </div>

    <div id="message" class="ota-message ota-hidden" aria-live="polite"></div>

    <div class="ota-grid">
      <form class="ota-card" id="releaseForm">
        <h3>Create Game OTA release</h3>
        <p>Version is read automatically from the ESP-IDF <code>DR_Game_FW</code> app descriptor.</p>

        <div class="ota-form">
          <div class="ota-field wide">
            <label>Version</label>
            <input class="ota-input" id="detectedVersion" readonly placeholder="Choose Game FW .bin" />
            <span class="ota-muted">Auto-detected from DR_Game_FW · format vHW_MAJOR.HW_MINOR.REVISION</span>
          </div>

          <div class="ota-field">
            <label>Game FW .bin</label>
            <input class="ota-input" id="firmwareFile" type="file" accept=".bin,application/octet-stream" required />
          </div>

          <div class="ota-field">
            <label>Assets .vgi.pack <span class="ota-muted">(optional)</span></label>
            <input class="ota-input" id="assetsFile" type="file" accept=".vgi.pack,application/octet-stream" />
          </div>

          <div class="ota-field wide">
            <label>Release notes</label>
            <textarea id="releaseNotes" placeholder="Changes in this release"></textarea>
          </div>
        </div>

        <div class="ota-progress ota-hidden" id="uploadProgress"><span></span></div>
        <div class="ota-actions">
          <button class="admin-button primary" id="saveRelease" type="submit">Upload & create draft</button>
        </div>
      </form>

      <div class="ota-card">
        <h3>Device API · OTA v2</h3>
        <p>Boot OS sends only the installed Game FW version. The first two version numbers define the hardware line.</p>
        <div class="ota-message">
          <strong>Check</strong><br />
          <code class="ota-mono">POST /api/dr/ota/v2/check</code><br /><br />
          <strong>Game FW</strong><br />
          <code class="ota-mono">GET /api/dr/ota/v2/game/v1.1.130</code><br /><br />
          <strong>Assets</strong><br />
          <code class="ota-mono">GET /api/dr/ota/v2/assets/v1.1.130</code>
        </div>
        <p style="margin-top:12px">Only <code>DR_Game_FW</code> binaries are accepted. Assets are optional and are installed by Boot OS before flashing the new Game FW.</p>
      </div>
    </div>

    <div class="admin-panel">
      <div class="ota-toolbar">
        <strong>Game OTA releases</strong>
        <span class="ota-muted">Published releases are immutable; create a newer revision for a new binary.</span>
      </div>
      <div class="ota-table-wrap">
        <table class="ota-table">
          <thead>
            <tr><th>Version</th><th>Game FW</th><th>Assets</th><th>Status</th><th>Notes</th><th>Actions</th></tr>
          </thead>
          <tbody id="releaseRows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const q = selector => document.querySelector(selector);
    const safeSessionGet = key => { try { return sessionStorage.getItem(key) || ''; } catch { return ''; } };
    const safeSessionSet = (key, value) => { try { sessionStorage.setItem(key, value); return true; } catch { return false; } };
    let token = safeSessionGet('rg_admin_token');
    let releases = [];
    const authHeaders = () => token ? { Authorization: `Bearer ${token}` } : {};
    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
    const fmtBytes = n => Number(n||0) < 1024 ? `${Number(n||0)} B` : Number(n||0) < 1048576 ? `${(Number(n)/1024).toFixed(1)} KB` : `${(Number(n)/1048576).toFixed(2)} MB`;
    const fmtDate = value => value ? new Date(value).toLocaleString() : '—';
    const message = (text, tone='') => { const el=q('#message'); el.textContent=text; el.className=`ota-message ${tone}`; el.classList.toggle('ota-hidden', !text); };

    async function api(path, options={}) {
      const response = await fetch(path, {
        ...options,
        headers: { ...authHeaders(), ...(options.json ? {'content-type':'application/json'} : {}), ...(options.headers||{}) }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw Object.assign(new Error(data.message || data.error || `HTTP ${response.status}`), { status: response.status, data });
      return data;
    }

    function setUploadProgress(percent, visible=true) {
      const wrap=q('#uploadProgress'), bar=wrap?.querySelector('span');
      if(!wrap||!bar)return;
      wrap.classList.toggle('ota-hidden',!visible);
      bar.style.width=`${Math.max(0,Math.min(100,Number(percent)||0))}%`;
    }

    function uploadFormData(path, formData, {method='POST', label='Uploading', timeout=180000}={}) {
      return new Promise((resolve,reject)=>{
        const xhr=new XMLHttpRequest();
        xhr.open(method,path,true);
        xhr.timeout=timeout;
        Object.entries(authHeaders()).forEach(([name,value])=>xhr.setRequestHeader(name,value));
        xhr.upload.onprogress=event=>{
          if(!event.lengthComputable||!event.total)return;
          const percent=Math.max(2,Math.min(90,Math.round((event.loaded/event.total)*90)));
          setUploadProgress(percent);
          message(`${label}… ${percent}%`);
        };
        xhr.upload.onload=()=>{setUploadProgress(94);message(`${label} complete. Validating and saving to R2…`);};
        xhr.onload=()=>{
          const data=(()=>{try{return JSON.parse(xhr.responseText||'{}');}catch{return {};}})();
          if(xhr.status>=200&&xhr.status<300){setUploadProgress(100);resolve(data);return;}
          reject(Object.assign(new Error(data.message||data.error||`HTTP ${xhr.status}`),{status:xhr.status,data}));
        };
        xhr.onerror=()=>reject(new Error('Upload failed because the network connection was interrupted.'));
        xhr.ontimeout=()=>reject(new Error('Upload timed out after 3 minutes.'));
        xhr.onabort=()=>reject(new Error('Upload was cancelled.'));
        setUploadProgress(1);
        xhr.send(formData);
      });
    }

    function readAscii(bytes, offset, length) {
      if (offset + length > bytes.length) return '';
      let end=offset;
      while(end<offset+length && bytes[end]!==0) end++;
      return new TextDecoder().decode(bytes.subarray(offset,end)).trim();
    }

    async function detectGameVersion(file) {
      if(!file) throw new Error('Choose a Game FW .bin file.');
      if(!file.name.toLowerCase().endsWith('.bin')) throw new Error('Game FW must be a .bin file.');
      const probe=new Uint8Array(await file.slice(0,Math.min(file.size,131072)).arrayBuffer());
      if(probe.length<80 || probe[0]!==0xE9) throw new Error('Invalid ESP32 Game FW image.');
      const view=new DataView(probe.buffer,probe.byteOffset,probe.byteLength);
      let sawDescriptorMagic=false;
      for(let offset=0;offset<=probe.length-80;offset+=4){
        if(view.getUint32(offset,true)!==0xABCD5432) continue;
        sawDescriptorMagic=true;
        const version=readAscii(probe,offset+16,32);
        const project=readAscii(probe,offset+48,32);
        if(project!=='DR_Game_FW')continue;
        if(!/^v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/.test(version)) {
          throw new Error('Game FW version must use vHW_MAJOR.HW_MINOR.REVISION.');
        }
        return version;
      }
      throw new Error(sawDescriptorMagic ? 'The selected BIN is not DR_Game_FW.' : 'DR_Game_FW app descriptor was not found in the BIN.');
    }

    function gameUrl(version) { return `${location.origin}/api/dr/ota/v2/game/${encodeURIComponent(version)}`; }
    function assetsUrl(version) { return `${location.origin}/api/dr/ota/v2/assets/${encodeURIComponent(version)}`; }

    function renderSummary() {
      q('#metricPublished').textContent=releases.filter(row=>row.status==='published').length;
      q('#metricDraft').textContent=releases.filter(row=>row.status==='draft').length;
      q('#metricLatest').textContent=releases[0]?.version || '—';
      q('#metricAssets').textContent=releases.filter(row=>row.assets_r2_key).length;
    }

    function renderReleases() {
      q('#releaseRows').innerHTML=releases.map(item=>{
        const published=item.status==='published';
        const gameActions=published
          ? `<button class="admin-button ota-mini" data-action="copy-game" data-version="${esc(item.version)}">Copy Game link</button><a class="admin-button ota-mini" href="/api/dr/ota/v2/game/${encodeURIComponent(item.version)}" target="_blank">Download Game</a>`
          : `<button class="admin-button ota-mini" data-action="replace-game" data-version="${esc(item.version)}">Update Game</button>`;
        const assetsActions=item.assets_r2_key
          ? (published
            ? `<button class="admin-button ota-mini" data-action="copy-assets" data-version="${esc(item.version)}">Copy Assets link</button><a class="admin-button ota-mini" href="/api/dr/ota/v2/assets/${encodeURIComponent(item.version)}" target="_blank">Download Assets</a>`
            : `<button class="admin-button ota-mini" data-action="replace-assets" data-version="${esc(item.version)}">Update Assets</button><button class="admin-button ota-mini" data-action="remove-assets" data-version="${esc(item.version)}">Remove Assets</button>`)
          : (!published ? `<button class="admin-button ota-mini" data-action="replace-assets" data-version="${esc(item.version)}">Add Assets</button>` : '<span class="ota-muted">—</span>');
        const releaseActions=published
          ? ''
          : `<button class="admin-button ota-mini primary" data-action="publish" data-version="${esc(item.version)}">Publish</button><button class="admin-button ota-mini ota-button-danger" data-action="delete" data-version="${esc(item.version)}">Delete</button>`;
        return `<tr>
          <td><strong>${esc(item.version)}</strong><br/><span class="ota-muted">HW${item.hw_major}.${item.hw_minor} · rev ${item.revision}</span><br/><span class="ota-muted">${fmtDate(item.created_at)}</span></td>
          <td>${fmtBytes(item.game_size)}<br/><code>${esc(String(item.game_sha256||'').slice(0,12))}…</code><div class="ota-table-actions">${gameActions}</div></td>
          <td>${item.assets_r2_key ? `${fmtBytes(item.assets_size)}<br/><code>${esc(String(item.assets_sha256||'').slice(0,12))}…</code>` : '<span class="ota-muted">No pack</span>'}<div class="ota-table-actions">${assetsActions}</div></td>
          <td><span class="ota-status ${esc(item.status)}">${esc(item.status)}</span></td>
          <td>${esc(item.notes||'—')}</td>
          <td><div class="ota-table-actions">${releaseActions}</div></td>
        </tr>`;
      }).join('') || '<tr><td colspan="6" class="ota-empty">No OTA v2 releases.</td></tr>';
    }

    async function loadAll({interactive=false}={}) {
      message('');
      try {
        await api('/api/admin/session');
        q('#loginPanel').classList.add('admin-hidden');
        q('#workspace').classList.remove('admin-hidden');
        const data=await api('/api/admin/ota/simple/releases');
        releases=data.items||[];
        renderReleases();
        renderSummary();
      } catch(error) {
        q('#workspace').classList.add('admin-hidden');
        q('#loginPanel').classList.remove('admin-hidden');
        if(error.status===401){
          if(interactive||token) message('Admin token is invalid or expired. Re-enter the current Admin Token.','error');
          return;
        }
        message(`Admin authentication failed: ${error.message||'Unable to reach admin API'}`,'error');
      }
    }

    async function chooseFile(accept) {
      return new Promise(resolve=>{
        const input=document.createElement('input');
        input.type='file'; input.accept=accept; input.style.position='fixed'; input.style.left='-9999px';
        document.body.appendChild(input);
        let settled=false;
        const finish=file=>{if(settled)return;settled=true;input.remove();resolve(file||null);};
        input.addEventListener('change',()=>finish(input.files?.[0]),{once:true});
        window.addEventListener('focus',()=>setTimeout(()=>{if(!input.files?.length)finish(null);},300),{once:true});
        input.click();
      });
    }

    async function replaceFile(version, kind) {
      const file=await chooseFile(kind==='game'?'.bin,application/octet-stream':'.vgi.pack,application/octet-stream');
      if(!file)return;
      if(kind==='game'){
        const detected=await detectGameVersion(file);
        if(detected!==version) throw new Error(`Replacement BIN is ${detected}; expected ${version}.`);
      }
      if(!confirm(`Replace ${kind} file for ${version}?`))return;
      const form=new FormData(); form.set('file',file);
      await uploadFormData(`/api/admin/ota/simple/releases/${encodeURIComponent(version)}/${kind}`,form,{method:'PUT',label:kind==='game'?'Uploading Game FW':'Uploading Assets'});
      await loadAll();
      message(`${kind==='game'?'Game FW':'Assets pack'} updated for ${version}.`,'good');
    }

    q('#firmwareFile').addEventListener('change',async()=>{
      const file=q('#firmwareFile').files?.[0];
      q('#detectedVersion').value='';
      if(!file)return;
      try{
        q('#detectedVersion').value=await detectGameVersion(file);
        message('');
      }catch(error){
        message(error.message,'error');
        q('#firmwareFile').value='';
      }
    });

    q('#releaseForm').addEventListener('submit',async event=>{
      event.preventDefault();
      const gameFile=q('#firmwareFile').files?.[0];
      const assetsFile=q('#assetsFile').files?.[0]||null;
      const saveButton=q('#saveRelease');
      if(!gameFile){message('Choose a Game FW .bin file.','error');return;}
      saveButton.disabled=true;
      let createdRelease=null;
      try{
        const version=await detectGameVersion(gameFile);
        q('#detectedVersion').value=version;
        const form=new FormData();
        form.set('file', gameFile);
        form.set('notes', q('#releaseNotes').value);
        createdRelease=await uploadFormData('/api/admin/ota/simple/releases',form,{label:'Uploading Game FW'});
        if(assetsFile){
          const assetsForm=new FormData();
          assetsForm.set('file',assetsFile);
          try{
            await uploadFormData(`/api/admin/ota/simple/releases/${encodeURIComponent(createdRelease.version)}/assets`,assetsForm,{method:'PUT',label:'Uploading Assets'});
          }catch(error){
            q('#releaseForm').reset();
            q('#detectedVersion').value='';
            await loadAll();
            message(`Game FW was uploaded as Draft (${createdRelease.version}), but Assets upload failed: ${error.message||'Unknown error'}. Use Add Assets on that draft instead of uploading the Game FW again.`,'error');
            return;
          }
        }
        q('#releaseForm').reset();
        q('#detectedVersion').value='';
        await loadAll();
        message(`${version} uploaded as Draft. Review files, then Publish.`,'good');
      }catch(error){
        message(error.message||'Upload failed.','error');
      }finally{
        saveButton.disabled=false;
        setTimeout(()=>setUploadProgress(0,false),800);
      }
    });

    q('#releaseRows').addEventListener('click',async event=>{
      const button=event.target.closest('button[data-action]');
      if(!button)return;
      const {action,version}=button.dataset;
      try{
        if(action==='copy-game'){
          await navigator.clipboard.writeText(gameUrl(version));
          message('Game FW link copied.','good'); return;
        }
        if(action==='copy-assets'){
          await navigator.clipboard.writeText(assetsUrl(version));
          message('Assets link copied.','good'); return;
        }
        if(action==='replace-game'){await replaceFile(version,'game');return;}
        if(action==='replace-assets'){await replaceFile(version,'assets');return;}
        if(action==='remove-assets'){
          if(!confirm(`Remove assets pack from ${version}?`))return;
          await api(`/api/admin/ota/simple/releases/${encodeURIComponent(version)}/assets`,{method:'DELETE'});
        } else if(action==='publish'){
          if(!confirm(`Publish ${version}? Published releases are immutable.`))return;
          await api(`/api/admin/ota/simple/releases/${encodeURIComponent(version)}/publish`,{method:'POST'});
        } else if(action==='delete'){
          if(!confirm(`Delete draft ${version}?`))return;
          await api(`/api/admin/ota/simple/releases/${encodeURIComponent(version)}`,{method:'DELETE'});
        }
        await loadAll();
        message(`${version}: ${action} completed.`,'good');
      }catch(error){message(error.message||'Action failed.','error');}
    });

    q('#refreshAll').addEventListener('click',()=>loadAll());
    q('#loginForm').addEventListener('submit',async event=>{
      event.preventDefault();
      token=q('#tokenInput').value.trim();
      if(!token){message('Enter the Admin Token.','error');return;}
      if(!safeSessionSet('rg_admin_token',token)) message('Browser storage is unavailable; token will be used for this page only.');
      await loadAll({interactive:true});
    });
    loadAll();
  </script>
</AdminShell>
