---
import AdminShell from '../../../components/admin/AdminShell.astro';
import { PAGE_DEFINITIONS } from '../../../cms/m2-pages.js';

const { slug = '' } = Astro.params;
const page = PAGE_DEFINITIONS[slug];

if (!page) {
  return Astro.redirect('/admin/pages/', 302);
}

if (page.managerRoute) {
  return Astro.redirect(page.managerRoute, 302);
}
---
<AdminShell title={`${page.title} manager`} subtitle="This public page is part of the current website structure, but its dedicated backend manager is not connected in this milestone." currentPath="/admin/pages/">
  <a slot="topbar-actions" class="admin-button subtle" href="/admin/pages/">← All pages</a>

  <section class="admin-section-head">
    <div>
      <h2>{page.title}</h2>
      <p>{page.route}</p>
    </div>
    <div class="admin-section-actions">
      <a class="admin-button" href={page.route} target="_blank" rel="noopener">Open public page ↗</a>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-state">
      <strong>Dedicated manager is not connected yet</strong>
      <span>{page.managerLabel}</span>
      <p>This page remains visible in the Pages map so the backend matches the current frontend, but editing is intentionally disabled until its dedicated workflow is implemented.</p>
    </div>
  </section>
</AdminShell>
