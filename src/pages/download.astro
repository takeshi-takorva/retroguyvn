---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Downloads — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow">Firmware & resources</p><h1>DOWNLOAD</h1><p class="lede">This area is reserved for verified firmware, manuals and future device content packages.</p></section>
  <section class="section">
    <div class="notice"><strong>V1 status:</strong> Public firmware downloads are not enabled yet. OTA and signed release delivery will be added in a later backend phase.</div>
    <div class="list" style="margin-top:24px">
      <article><h3>Firmware releases</h3><p>Future stable firmware packages grouped by hardware revision with release notes and checksums.</p></article>
      <article><h3>Manuals & guides</h3><p>Quick-start instructions, controls, troubleshooting and product documentation.</p></article>
      <article><h3>Content packages</h3><p>Future verified assets and game content updates distributed separately from firmware where possible.</p></article>
    </div>
  </section>
</BaseLayout>
