---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Downloads — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow" data-cms="eyebrow">Firmware & resources</p><h1 data-cms="heading">DOWNLOAD</h1><p class="lede" data-cms="lede">This area is reserved for verified firmware, manuals and future device content packages.</p></section>
  <section class="section">
    <div class="notice"><strong data-cms="statusLabel">V1 status:</strong> <span data-cms="statusText">Public firmware downloads are not enabled yet. OTA and signed release delivery will be added in a later backend phase.</span></div>
    <div class="list" style="margin-top:24px">
      <article><h3 data-cms="items.0.title">Firmware releases</h3><p data-cms="items.0.text">Future stable firmware packages grouped by hardware revision with release notes and checksums.</p></article>
      <article><h3 data-cms="items.1.title">Manuals & guides</h3><p data-cms="items.1.text">Quick-start instructions, controls, troubleshooting and product documentation.</p></article>
      <article><h3 data-cms="items.2.title">Content packages</h3><p data-cms="items.2.text">Future verified assets and game content updates distributed separately from firmware where possible.</p></article>
    </div>
  </section>
</BaseLayout>
