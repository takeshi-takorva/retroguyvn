---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="News — RetroGuy VN" description="Official RetroGuy VN announcements, product updates and public notices.">
  <section class="page-hero news-hero">
    <p class="eyebrow">Official announcements</p>
    <h1>NEWS</h1>
    <p class="lede">Product announcements, release information and public updates from RetroGuy VN. Development journals are published separately in Dev Log.</p>
  </section>

  <section class="section news-shell">
    <div class="news-empty">
      <span class="tag">News</span>
      <h2>No published news yet.</h2>
      <p>Development progress, hardware revisions and build notes have moved to Dev Log.</p>
      <a class="button secondary" href="/devlog">Open Dev Log</a>
    </div>
  </section>

  <style>
    .news-shell{padding-top:28px}.news-empty{padding:48px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(160deg,rgba(15,32,52,.78),rgba(5,9,20,.7))}.news-empty h2{margin:16px 0 12px;font-size:clamp(2rem,5vw,4rem)}.news-empty p{max-width:760px;color:var(--muted);font-size:1.02rem}.news-empty .button{margin-top:18px}
  </style>
</BaseLayout>
