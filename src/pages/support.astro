---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow">Help & contact</p><h1>SUPPORT</h1><p class="lede">Support V1 provides a clear home for setup guidance, troubleshooting, warranty information and contact channels as they become available.</p></section>
  <section class="section">
    <div class="grid">
      <article class="card"><span class="num">START</span><h3>Quick start</h3><p>Device setup, controls, charging, storage and first-run instructions will be published here.</p></article>
      <article class="card"><span class="num">FIX</span><h3>Troubleshooting</h3><p>Known issues, recovery steps and firmware-specific notes will be maintained alongside releases.</p></article>
      <article class="card"><span class="num">CONTACT</span><h3>Get in touch</h3><p>Official community and support contact details will be added before public launch.</p></article>
    </div>
  </section>
</BaseLayout>
