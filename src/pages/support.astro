---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow" data-cms="eyebrow">Help & contact</p><h1 data-cms="heading">SUPPORT</h1><p class="lede" data-cms="lede">Support V1 provides a clear home for setup guidance, troubleshooting, warranty information and contact channels as they become available.</p></section>
  <section class="section">
    <div class="grid">
      <article class="card"><span class="num" data-cms="cards.0.badge">START</span><h3 data-cms="cards.0.title">Quick start</h3><p data-cms="cards.0.text">Device setup, controls, charging, storage and first-run instructions will be published here.</p></article>
      <article class="card"><span class="num" data-cms="cards.1.badge">FIX</span><h3 data-cms="cards.1.title">Troubleshooting</h3><p data-cms="cards.1.text">Known issues, recovery steps and firmware-specific notes will be maintained alongside releases.</p></article>
      <article class="card"><span class="num" data-cms="cards.2.badge">CONTACT</span><h3 data-cms="cards.2.title">Get in touch</h3><p data-cms="cards.2.text">Official community and support contact details will be added before public launch.</p></article>
    </div>
  </section>
</BaseLayout>
