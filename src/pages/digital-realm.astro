---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Digital Realm — RetroGuy VN" description="Discover Digital Realm, RetroGuy VN's connected pocket-world project.">
  <section class="page-hero">
    <p class="eyebrow" data-cms="eyebrow">Flagship project</p>
    <h1 data-cms="heading">DIGITAL REALM</h1>
    <p class="lede" data-cms="lede">A connected virtual-pet adventure built around exploration, care, collection and team combat — designed for a dedicated handheld instead of a phone screen.</p>
  </section>
  <section class="section">
    <div class="content-grid">
      <div class="media-frame" data-cms="showcaseLabel">Product artwork / video placeholder</div>
      <div>
        <span class="tag" data-cms="tag">Portable world</span>
        <h2 data-cms="showcaseHeading">Carry the realm with you.</h2>
        <p class="lede" data-cms="showcaseText">The device is the portal. Your companion lives, grows and travels with you while the world expands through maps, events, quests and future network services.</p>
        <div class="actions"><a class="button" href="/features" data-cms="primaryAction">Explore features</a><a class="button secondary" href="/gallery" data-cms="secondaryAction">View media</a></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="grid">
      <article class="card"><span class="num" data-cms="cards.0.badge">WORLD</span><h3 data-cms="cards.0.title">Explore</h3><p data-cms="cards.0.text">Connected regions with distinct climates, cities, NPC roles, resources, quests and activities.</p></article>
      <article class="card"><span class="num" data-cms="cards.1.badge">COMPANION</span><h3 data-cms="cards.1.title">Raise</h3><p data-cms="cards.1.text">Care routines, training, evolution and long-term progression give your character a persistent life.</p></article>
      <article class="card"><span class="num" data-cms="cards.2.badge">COMBAT</span><h3 data-cms="cards.2.title">Team battle</h3><p data-cms="cards.2.text">A 3v3 combat foundation supports solo, team and future online competitive modes.</p></article>
    </div>
  </section>
</BaseLayout>
