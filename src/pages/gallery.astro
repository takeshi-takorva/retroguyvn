---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Media — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow" data-cms="eyebrow">Screenshots & media</p><h1 data-cms="heading">MEDIA</h1><p class="lede" data-cms="lede">A dedicated space for product photography, game captures, concept art and development videos.</p></section>
  <section class="section">
    <div class="content-grid">
      <div class="media-frame" data-cms="items.0">Product photography</div>
      <div class="media-frame" data-cms="items.1">Gameplay capture</div>
      <div class="media-frame" data-cms="items.2">World / map art</div>
      <div class="media-frame" data-cms="items.3">Development video</div>
    </div>
  </section>
</BaseLayout>
