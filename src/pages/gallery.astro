---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Media — RetroGuy VN">
  <section class="page-hero"><p class="eyebrow">Screenshots & media</p><h1>MEDIA</h1><p class="lede">A dedicated space for product photography, game captures, concept art and development videos.</p></section>
  <section class="section">
    <div class="content-grid">
      <div class="media-frame">Product photography</div>
      <div class="media-frame">Gameplay capture</div>
      <div class="media-frame">World / map art</div>
      <div class="media-frame">Development video</div>
    </div>
  </section>
</BaseLayout>
