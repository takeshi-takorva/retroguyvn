{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retroguyvn",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/media/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CMS",
        "class_name": "CMSStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cms-m1-v1",
      "new_sqlite_classes": ["CMSStore"]
    }
  ],
  "vars": {
    "ADMIN_TOKEN_SHA256": "4177df44062d14b628e4c8b1c24ea780706aa99967fb7544acffc5493cb93c2c"
  },
  "observability": {
    "enabled": true
  }
}
